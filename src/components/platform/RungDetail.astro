---
/*
 * The full account of one option: what it is for, what it is not for, and
 * where the lock-in sits. Rendered server-side for all five and revealed by
 * the chooser, so the content exists without scripting.
 */
import type { Rung } from '../../data/platform-ladder';

interface Props {
  rung: Rung;
  hidden?: boolean;
}

const { rung, hidden = false } = Astro.props;
---

<div class="rd" data-detail={rung.key} hidden={hidden}>
  <!-- No model here: "Best fit · Packaging" reads as a category claim, and
       Container is a packaging decision rather than a hosting tier. The model
       appears where it has context — the tab and the register column. -->
  <p class="rd__kicker">Best fit</p>
  <h3 class="rd__name">{rung.name}</h3>
  <p class="rd__line">{rung.oneLine}</p>

  <div class="rd__cols">
    <div class="rd__col">
      <h4 class="rd__col-head">Right when</h4>
      <ul role="list">{rung.goodWhen.map((item) => <li>{item}</li>)}</ul>
    </div>
    <div class="rd__col rd__col--against">
      <h4 class="rd__col-head">Wrong call when</h4>
      <ul role="list">{rung.badWhen.map((item) => <li>{item}</li>)}</ul>
    </div>
  </div>

  <div class="rd__lock">
    <p class="rd__lock-head">Lock-in: <span>{rung.lockIn.level}</span></p>
    <p class="rd__lock-body">{rung.lockIn.where}</p>
  </div>

  <p class="rd__door"><span>Keep the door open</span> {rung.keepDoorOpen}</p>
  <p class="rd__examples"><span>Azure</span> {rung.examples.azure} <span>OCI</span> {rung.examples.oci}</p>
</div>

<style>
  .rd[hidden] { display: none; }
  .rd__kicker { font: var(--text-label-sm) var(--font-mono); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--color-primary); }
  .rd__name {
    margin-top: var(--space-2);
    font-family: var(--font-display); font-size: var(--text-headline-md);
    font-weight: var(--weight-semibold); letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug); color: var(--color-navy);
  }
  .rd__line { margin-top: var(--space-3); font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--color-on-surface); }

  .rd__cols { display: grid; gap: var(--space-5); margin-top: var(--space-5); }
  .rd__col-head {
    font: var(--weight-semibold) var(--text-label-md) var(--font-body);
    text-transform: uppercase; letter-spacing: var(--tracking-wide);
    color: var(--color-meta-label);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-divider-strong);
  }
  .rd__col ul { margin-top: var(--space-3); display: flex; flex-direction: column; gap: var(--space-3); }
  .rd__col li {
    position: relative; padding-left: var(--space-4);
    font-size: var(--text-body-md); line-height: var(--leading-relaxed);
    color: var(--color-on-surface-muted);
  }
  .rd__col li::before {
    content: ''; position: absolute; left: 0; top: 0.55em;
    width: 6px; height: 1px; background: var(--color-primary);
  }
  .rd__col--against li::before { background: var(--color-meta-label); }

  .rd__lock { margin-top: var(--space-5); padding: var(--space-4) var(--space-5); background: var(--color-primary-tint); }
  .rd__lock-head { font: var(--weight-semibold) var(--text-label-md) var(--font-body); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--color-primary); }
  .rd__lock-head span { text-transform: none; letter-spacing: normal; color: var(--color-navy); }
  .rd__lock-body { margin-top: var(--space-2); font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--color-navy); }

  .rd__door, .rd__examples { margin-top: var(--space-4); font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--color-on-surface-muted); }
  .rd__door span, .rd__examples span {
    font: var(--text-label-sm) var(--font-mono); text-transform: uppercase;
    letter-spacing: var(--tracking-wide); color: var(--color-meta-label);
    margin-right: var(--space-2);
  }
  .rd__examples span:not(:first-child) { margin-left: var(--space-4); }

  /* Keyed to the panel, not the viewport — this renders inside a narrow sticky
     column on desktop and full width on mobile, so the viewport tells us the
     opposite of what we need to know. */
  @container (min-width: 34rem) {
    .rd__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
