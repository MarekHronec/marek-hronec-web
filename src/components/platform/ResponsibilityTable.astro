---
/*
 * Who owns what, for each of the five. A register rather than a panel —
 * scanning across columns needs the guide, which is what DESIGN.md reserves
 * rules for.
 *
 * The staircase down the middle is the point: the boundary slides as you climb.
 * So are the bottom two rows, which never move.
 */
import { APPROACHES, STACK_LAYERS, OWNER_LABEL } from '../../data/platform-approaches';
---

<div class="resp">
  <div class="resp__head">
    <h2 class="resp__title">The line moves. Two rows never do.</h2>
    <p class="resp__lede">
      Every provider publishes a version of this chart, and every one of them
      draws its own share slightly larger than it really is. Read it as a shape
      rather than a contract: the boundary slides as you hand more over, and
      configuration and data stay on your side of it every time — including
      where you run nothing at all.
    </p>
  </div>

  <div class="resp__scroll">
    <table class="resp__table">
      <caption class="resp__caption">Who is responsible for what. Real boundaries are service-by-service; this is the shape, not the contract.</caption>
      <thead>
        <tr>
          <th scope="col" class="resp__corner">Layer</th>
          {APPROACHES.map((approach) => (
            <th scope="col" class="resp__col">
              <span class="resp__col-name">{approach.name}</span>
              <span class="resp__col-model">{approach.model}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {STACK_LAYERS.map((layer) => (
          <tr>
            <th scope="row" class="resp__row">
              <span class="resp__row-label">{layer.label}</span>
              <span class="resp__row-hint">{layer.hint}</span>
            </th>
            {APPROACHES.map((approach) => (
              <td class={`resp__cell resp__cell--${approach.owns[layer.key]}`}>{OWNER_LABEL[approach.owns[layer.key]]}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="resp__foot">
    “Shared” is where the outages live. A managed control plane still leaves you
    the node upgrade; a managed runtime still leaves you the tracing, the alert
    logic and the incident. Read the specific service, not the category.
  </p>
</div>

<style>
  .resp { padding-block: var(--space-8); }
  .resp__head { max-width: var(--container-content); margin-bottom: var(--space-6); }
  .resp__title {
    font-family: var(--font-display);
    font-size: clamp(var(--text-title-lg), 3vw, var(--text-headline-md));
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    color: var(--color-on-surface);
    text-wrap: balance;
  }
  .resp__lede {
    margin-top: var(--space-3); max-width: 76ch;
    font-size: var(--text-body-lg); line-height: var(--leading-relaxed);
    color: var(--color-on-surface-muted);
  }

  /* Wide content scrolls inside its own container; the page never does. */
  .resp__scroll { overflow-x: auto; }
  .resp__table { width: 100%; min-width: 46rem; border-collapse: collapse; text-align: left; }
  .resp__caption { text-align: left; padding-bottom: var(--space-3); font: var(--text-label-sm) var(--font-mono); color: var(--color-meta-label); }

  .resp__corner, .resp__col {
    padding: var(--space-3) var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-divider-strong);
    vertical-align: bottom;
  }
  .resp__corner { font: var(--text-label-sm) var(--font-mono); text-transform: uppercase; letter-spacing: var(--tracking-wide); color: var(--color-meta-label); }
  .resp__col { display: table-cell; }
  .resp__col-name { display: block; font: var(--weight-semibold) var(--text-label-md) var(--font-body); color: var(--color-on-surface); }
  .resp__col-model { display: block; margin-top: var(--space-1); font: var(--text-label-sm) var(--font-mono); color: var(--color-meta-label); }

  .resp__row {
    padding: var(--space-4) var(--space-4) var(--space-4) 0;
    border-bottom: 1px solid var(--color-divider);
    vertical-align: top; max-width: 16rem;
  }
  .resp__row-label { display: block; font: var(--weight-medium) var(--text-body-md) var(--font-body); color: var(--color-on-surface); }
  .resp__row-hint { display: block; margin-top: var(--space-1); font-size: var(--text-label-sm); line-height: var(--leading-normal); color: var(--color-on-surface-muted); }

  .resp__cell {
    padding: var(--space-4) var(--space-3);
    border-bottom: 1px solid var(--color-divider);
    font: var(--text-label-md) var(--font-body);
    letter-spacing: var(--tracking-wide);
    white-space: nowrap;
  }
  .resp__cell--provider { color: var(--color-meta-label); }
  .resp__cell--shared { color: var(--color-primary); }
  .resp__cell--you {
    color: var(--color-navy);
    font-weight: var(--weight-semibold);
    background-color: var(--color-primary-tint);
  }

  .resp__foot {
    margin-top: var(--space-5); max-width: 72ch;
    font-size: var(--text-body-md); line-height: var(--leading-relaxed);
    color: var(--color-on-surface-muted);
  }
</style>
