---
interface Props { title: string; accent: string; description: string; tool?: { href: string; title: string; description: string }; reference?: { href: string; title: string; description: string } }
const { title, accent, description, tool, reference } = Astro.props;
---
<header class="guide-hero container">
  <p class="guide-hero__label">Architecture Guides</p>
  <h1>{title} <span>{accent}</span>.</h1>
  <p class="guide-hero__description">{description}</p>
  {tool && reference && <div class="guide-hero__choices">{[tool, reference].map((choice, i) => <a href={choice.href}><small>{i === 0 ? 'Tool' : 'Learn'}</small><h2>{choice.title}</h2><p>{choice.description}</p><span>Explore &rarr;</span></a>)}</div>}
</header>
<style>
  .guide-hero { padding-block: var(--space-12) var(--space-8); }
  .guide-hero__label { font: var(--text-label-sm) var(--font-mono); color: var(--color-primary); letter-spacing: var(--tracking-wide); text-transform: uppercase; margin-bottom: var(--space-4); }
  h1 { max-width: 18ch; font: var(--weight-bold) clamp(2.5rem, 6vw, var(--text-display-lg))/var(--leading-tight) var(--font-display); letter-spacing: var(--tracking-tight); color: var(--color-on-surface); }
  h1 span { color: var(--color-primary); }
  .guide-hero__description { max-width: 76ch; margin-top: var(--space-5); color: var(--color-on-surface-muted); font-size: var(--text-body-lg); line-height: var(--leading-relaxed); }
  .guide-hero__choices { display: grid; gap: var(--space-4); margin-top: var(--space-7); }
  a { display: block; padding: var(--space-5); background: var(--color-surface-container-low); color: var(--color-navy); }
  a:hover { background: var(--color-primary-tint); }
  small { font: var(--text-label-sm) var(--font-mono); text-transform: uppercase; }
  h2 { margin-top: var(--space-3); font-size: var(--text-title-lg); }
  a p { margin-block: var(--space-3); line-height: var(--leading-relaxed); color: var(--color-on-surface-muted); }
  a > span { font-size: var(--text-label-md); font-weight: var(--weight-semibold); }
  @media (min-width: 768px) { .guide-hero__choices { grid-template-columns: 1fr 1fr; } }
</style>
