---
interface Props { title: string; accent: string; description: string }
const { title, accent, description } = Astro.props;
---
<header class="guide-hero container">
  <h1>{title} <span>{accent}</span>.</h1>
  <p>{description}</p>
</header>
<style>
  .guide-hero { padding-block: calc(var(--space-8) + var(--space-4)) var(--space-6); }
  h1 { max-width: 26ch; font: var(--weight-bold) clamp(2.5rem, 6vw, var(--text-display-lg))/var(--leading-tight) var(--font-display); letter-spacing: var(--tracking-tight); color: var(--color-on-surface); }
  h1 span { color: var(--color-primary); }
  p { max-width: 76ch; margin-top: var(--space-5); color: var(--color-on-surface-muted); font-size: var(--text-body-lg); line-height: var(--leading-relaxed); }
</style>
