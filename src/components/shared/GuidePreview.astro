      <path d="M47 81 V49 H76 V81 M51 49 V40 H74 M62 40 V28 H85 M54 57 H67 M54 65 H67" />
      <path class="wash" d="M89 57 H128 V81 H89Z M134 57 H173 V81 H134Z" />
      <path d="M89 57 H128 V81 H89Z M134 57 H173 V81 H134Z M96 62 V76 M121 62 V76 M141 62 V76 M166 62 V76" />
      <path class="reverse" d="M46 89 Q132 101 212 89" />
