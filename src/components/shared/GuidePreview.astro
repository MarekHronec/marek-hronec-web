    <path class="wash" d="M33 29 L103 20 L160 32 L222 22 V105 L160 115 L103 102 L33 112Z" />
    <path d="M33 29 L103 20 L160 32 L222 22 V105 L160 115 L103 102 L33 112Z M103 20 V102 M160 32 V115" />
    <path class="faint" d="M42 79 Q57 52 82 64 T122 78 T185 67 M45 90 Q65 73 84 81 M174 96 Q192 88 211 92" />
    <path stroke-dasharray="3 5" d="M57 91 C71 32 137 104 190 51" />
    <circle cx="57" cy="91" r="3" class="solid"/><circle cx="190" cy="51" r="3" />
    <path d="M191 9 V31 M180 20 H202 M184 27 L198 13" />
    <path class="solid" d="M191 9 L195 20 L191 17 L187 20Z" />
  </g> : kind === 'reading' ? <g>
    <path class="wash" d="M39 33 Q83 23 127 40 Q171 23 216 33 V101 Q173 89 127 108 Q82 90 39 101Z" />
    <path d="M39 33 Q83 23 127 40 Q171 23 216 33 V101 Q173 89 127 108 Q82 90 39 101Z M127 40 V108 M32 40 V109 Q80 97 127 116 Q175 97 223 109 V40" />
