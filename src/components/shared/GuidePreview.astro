      <path class="wash" d="M44 93 H139 V104 H44Z" />
      <path d="M179 98 H226 L219 106 H187Z M195 97 V71 L212 94 H198 M193 76 L183 94 H192" />
      <path stroke-dasharray="3 4" d="M158 61 V110" />
      <circle cx="158" cy="50" r="10"/><path d="m153 50 4 4 6-8" />
    </g>}
    {guide === 'connectivity' && <g>
      <path d="M19 89 H65 V99 H19 M29 89 V57 H55 V89 M25 57 L42 46 L59 57 M35 66 H48 M197 89 H241 V99 H197 M207 89 V57 H232 V89 M203 57 L219 46 L237 57" />
      <path stroke-dasharray="3 5" d="M65 68 Q133 13 197 68 M65 94 Q132 120 197 94" />
      <path class="solid" d="M107 84 H163 L154 96 H117Z" /><path d="M120 83 V66 H138 V83 M127 66 V55 H141" />
    </g>}
    {guide === 'resilience' && <g>
      <path class="wash" d="M84 43 L165 24 V56Z" />
      <path d="M55 101 L64 49 H83 L92 101 M60 36 H87 V49 H60Z M56 36 L74 24 L92 36 M48 103 H99 M69 99 V86 H78 V99 M62 63 H85" />
      <path class="solid" d="M155 88 H223 L211 103 H166Z" /><path d="M169 87 V69 H188 V87 M176 69 V56 H193" />
      <path class="faint" d="M146 48 Q160 39 173 48 M174 43 Q188 33 202 43" />
    </g>}
    {guide === 'cost' && <g>
      <path class="solid" d="M29 87 H143 L130 104 H46Z" /><path d="M44 87 V63 H69 V87 M48 70 H60 M54 63 V49 H77" />
      <path d="M81 69 H125 V86 H81Z M88 73 V82 M118 73 V82" />
      <path d="M165 32 H216 V98 H165Z M174 45 H207 M174 56 H202 M174 67 H207 M174 85 H188" />
      <path class="faint" d="M177 25 H223 V91" />
    </g>}
  </g>}
</svg>
<style>
  .guide-preview { width: 100%; stroke: var(--guide-ink, var(--color-primary)); stroke-width: 1.2; stroke-linejoin: round; stroke-linecap: round; }
  .wash { fill: var(--guide-wash, var(--color-primary-tint)); stroke: none; }
  .solid { fill: var(--guide-solid, var(--color-navy)); stroke: var(--guide-solid, var(--color-navy)); }
  .reverse { stroke: var(--guide-reverse, var(--color-on-primary)); }
  .faint { opacity: .4; }
</style>
