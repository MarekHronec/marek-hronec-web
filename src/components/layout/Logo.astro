---
/*
 * Brand mark — MH monogram on a fouled anchor inside an open ring.
 * Geometry is the vectorised master artwork, untouched; only the paint is
 * ours, so the same file serves the navy-on-paper header and any
 * white-on-navy plate.
 *
 * The trace's thinnest element (the ring) is ~10 units in an 845-unit box,
 * which lands under half a CSS pixel at header size and washes out to grey.
 * Stroking the shapes in their own fill colour dilates every edge outward;
 * the width is solved per render so that ring never falls below MIN_STROKE_PX,
 * and drops to zero once the natural geometry is already thick enough.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: className } = Astro.props;

const VIEWBOX = 845;
const RING_UNITS = 10;
const MIN_STROKE_PX = 1.1;

const dilate = Math.max(0, (MIN_STROKE_PX * VIEWBOX) / size - RING_UNITS);
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="203 136 845 845"
  fill="currentColor"
  fill-rule="evenodd"
  stroke="currentColor"
  stroke-width={dilate}
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
