---
import CompassRose from '../icons/CompassRose.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner container">
    <p class="footer__copy">
      &copy; {year} Marek Hronec. All rights reserved.
    </p>

    <CompassRose size={20} class="footer__rose" aria-hidden="true" />

    <a
      class="footer__linkedin"
      href="https://www.linkedin.com/in/marekhronec"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Marek Hronec on LinkedIn"
    >
      LinkedIn
    </a>
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-navy);
    padding-block: var(--space-5);   /* 24px — compact */
    margin-top: 0;                   /* CTA section bottom padding handles the gap */
  }

  /* On KB pages the fixed category bar sits at the bottom of the viewport
     and would overlap the footer. :has() scopes this to pages that actually
     render the bar, so the footer height is normal everywhere else. */
  @media (max-width: 767px) {
    body:has(.kb-mobile-bar) .footer {
      padding-bottom: calc(var(--space-5) + 4.5rem + env(safe-area-inset-bottom, 0px));
    }
  }

  /* 1fr / auto / 1fr keeps the rose optically centred regardless of copy width */
  .footer__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
  }

  .footer__copy {
    font-size: var(--text-label-md);
    font-weight: var(--weight-medium);
    color: var(--color-on-dark-muted);
  }

  .footer__rose {
    color: var(--color-on-inverse-surface);
    opacity: 0.35;
  }

  .footer__linkedin {
    justify-self: end;
    font-size: var(--text-label-md);
    font-weight: var(--weight-semibold);
    color: var(--color-on-cta);
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .footer__linkedin:hover {
    opacity: 0.7;
  }
</style>
