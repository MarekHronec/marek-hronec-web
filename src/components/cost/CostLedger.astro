---
import { billingExample } from '../../data/cost-billing';
import BillingControls from './BillingControls.astro';
import type { CostKey } from '../../data/cost-concepts';
interface Props { concept: CostKey }
const {concept}=Astro.props;
const example=billingExample(concept);
const before=example.rows.reduce((sum,r)=>sum+r.before,0);
const after=example.rows.reduce((sum,r)=>sum+r.after,0);
const euro=(n:number)=>'€'+n.toLocaleString('en-IE');
---
<aside class="cost-ledger" data-cost-ledger data-concept={concept} data-before={before} data-after={after} data-period={concept==='operations'?'per month':'this month'} aria-label="Illustrative monthly cost comparison">
  <header>{concept==='operations'?'Monthly cost · includes team time':'This 30-day month'} <span>Illustrative € · not provider prices</span></header>
  <div class="cost-ledger__total">
    <span><small>Before</small><b data-cost-before>{euro(before)}</b></span>
    <span class="cost-ledger__arrow" aria-hidden="true">→</span>
    <span><small>After the action</small><b data-cost-total>{euro(before)}</b></span>
    <strong class="cost-ledger__delta" data-cost-delta>€0 change</strong>
  </div>
  <p class="cost-ledger__summary" data-cost-summary>{example.summary}</p>
  <p class="cost-ledger__announcement" data-cost-announcement role="status" aria-atomic="true"></p>
  <details class="cost-ledger__details">
    <summary>Billing assumptions &amp; breakdown</summary>
    <BillingControls concept={concept} />
    <dl>{example.rows.map(row=><div data-cost-row data-before={row.before} data-after={row.after}>
      <dt>{row.label}</dt><dd><span data-row-before>{euro(row.before)} → </span><strong data-cost-value>{euro(row.before)}</strong></dd>
    </div>)}</dl>
    <p data-cost-accrual>{example.accrued!==undefined?euro(example.accrued)+' already accrued or owed at release. Earlier charges are not refunded.':''}</p>
    <p data-cost-assumption>{example.assumption}</p>
    <p data-cost-outcome>After the decision: {example.outcome}</p>
    <p>Rounded estimates for two scenarios, not a live balance or refund.</p>
  </details>
</aside>
<style>
.cost-ledger { padding:var(--space-4); background:var(--color-surface-container-low); color:var(--color-navy); }
header { display:flex; flex-wrap:wrap; justify-content:space-between; gap:var(--space-1) var(--space-3); font-size:var(--text-label-sm); font-weight:var(--weight-semibold); }
header span { color:var(--color-on-surface-muted); font-weight:var(--weight-regular); }
.cost-ledger__announcement { position:absolute; inline-size:var(--space-1); block-size:var(--space-1); overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
.cost-ledger__total { display:grid; grid-template-columns:auto auto 1fr; align-items:center; gap:var(--space-2) var(--space-3); margin-block:var(--space-3) var(--space-2); }
small { display:block; font-size:var(--text-label-sm); color:var(--color-on-surface-muted); }
b { font:var(--weight-semibold) var(--text-headline-md)/var(--leading-snug) var(--font-display); font-variant-numeric:tabular-nums; }
[data-cost-before] { color:var(--color-on-surface-muted); }
.cost-ledger__arrow { color:var(--color-primary); }
.cost-ledger__delta { grid-column:1/-1; color:var(--color-primary); font-size:var(--text-body-md); }
.cost-ledger__summary { font-size:var(--text-label-md); line-height:var(--leading-relaxed); }
.cost-ledger__details { margin-top:var(--space-3); font-size:var(--text-label-md); line-height:var(--leading-relaxed); }
summary { cursor:pointer; color:var(--color-primary); font-weight:var(--weight-semibold); }
dl { margin-block:var(--space-3); }
dl > div { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:var(--space-3); margin-top:var(--space-2); }
dd { margin:0; font-variant-numeric:tabular-nums; }
dd span { color:var(--color-on-surface-muted); }
.cost-ledger__details p { margin-top:var(--space-2); color:var(--color-on-surface-muted); }
.cost-ledger__details p:empty { display:none; }
@media (min-width:640px) { .cost-ledger__total { grid-template-columns:auto auto auto 1fr; } .cost-ledger__delta { grid-column:auto; text-align:right; max-width:14ch; justify-self:end; } }
</style>
