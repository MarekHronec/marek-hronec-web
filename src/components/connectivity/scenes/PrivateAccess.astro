---
import ConnectivityFigure from '../ConnectivityFigure.astro';
import SailingVessel from '../../compliance/scenes/SailingVessel.astro';
import ChartWater from '../../compliance/scenes/ChartWater.astro';
---
<ConnectivityFigure label="Harbour gate and cargo permit illustration">
<svg class="scene net" viewBox="0 0 600 440" role="img" aria-labelledby="access-title access-desc">
<title id="access-title">A harbour entrance and a cargo permit are different checks</title>
<desc id="access-desc">A boom closes the public harbour entrance and an outside yacht stops. At the private quay a cargo permit is rejected, then an approved consignment is lifted into the warehouse. The harbour log records unreachable, denied and allowed.</desc>
<g transform="translate(0 -25)"><ChartWater id="access-marine"/></g>
<text class="label" x="24" y="30">HARBOUR ACCESS / CARGO PERMITS</text>
<path class="scene__hull" d="M312 108 H574 V273 H527 V225 H312 Z"/>
<path class="scene__line" d="M319 218 H573 M325 228 V248 M372 228 V248 M420 228 V248 M469 228 V248"/>
<path class="scene__paper" d="M430 158 V92 L488 56 L547 92 V158 Z"/>
<path class="scene__line" d="M438 96 H538 M450 111 H471 V132 H450 Z M503 111 H525 V132 H503 Z M479 158 V120 H493 V158"/>
<text class="label" x="443" y="179">WAREHOUSE</text>
<path class="scene__heavy" d="M321 107 V199 M276 219 V256"/>
<g class="boom"><path class="scene__hull" d="M286 213 L324 112 L329 115 L291 217 Z"/><path class="scene__line" d="M292 192 l6 2 M303 160 l6 2 M314 131 l6 2"/></g>
<g class="travel public-request"><g transform="scale(.55)"><SailingVessel/></g></g>
<text class="small" x="35" y="247">Public entrance</text>
<text class="small" x="321" y="271">Private quay → permit check</text>
<path class="scene__heavy" d="M348 208 V116 H412 M350 117 L408 144 M402 116 V155"/>
<path class="scene__line" d="M341 208 H360 M402 151 q-8 9 0 13 q8 0 7 -7"/>
<g class="travel denied-request"><path class="scene__paper" d="M-12 -20 H13 V9 H-12 Z"/><path class="scene__line" d="M-7 -13 H8 M-7 -7 H8"/></g>
<g class="travel accepted-request"><path class="scene__crate" d="M-17 -21 H17 V4 H-17 Z"/><path class="scene__line" d="M-17 -21 L17 4 M17 -21 L-17 4 M-17 -21 L0 -34 L17 -21"/></g>
<rect class="ink" x="24" y="306" width="552" height="116"/>
<text class="label white" x="40" y="331">HARBOUR LOG</text>
<text class="small white" x="40" y="358">Outside yacht</text><text class="small white" x="215" y="358">Invalid permit</text><text class="small white" x="401" y="358">Valid permit</text>
<text class="white scene__before" x="40" y="390">Entrance open · cargo still needs permission</text>
<text class="label white reveal public-result" x="40" y="390">UNREACHABLE</text>
<text class="label white reveal denied-result" x="215" y="390">DENIED ×</text>
<text class="label white reveal accepted-result" x="401" y="390">ALLOWED ✓</text>
</svg>
</ConnectivityFigure>
<style>
.boom { transform-box:view-box; transform-origin:324px 113px; transform:rotate(-60deg); }
.public-request { offset-path:path("M96 206 H247"); }
.denied-request { offset-path:path("M332 190 H408"); opacity:0; }
.accepted-request { offset-path:path("M354 206 C362 179 381 163 402 158 H492"); opacity:0; }
:global(.cp[data-demonstrate='true']) .boom { animation: close-boom var(--nautical-story-duration) var(--ease-standard) both; }
:global(.cp[data-demonstrate='true']) .public-request { animation: public-test var(--nautical-story-duration) linear both; }
:global(.cp[data-demonstrate='true']) .denied-request { animation: denied-test var(--nautical-story-duration) linear both; }
:global(.cp[data-demonstrate='true']) .accepted-request { animation: accepted-test var(--nautical-story-duration) linear both; }
:global(.cp[data-demonstrate='true']) .public-result { animation: public-result var(--nautical-story-duration) step-end both; }
:global(.cp[data-demonstrate='true']) .denied-result { animation: denied-result var(--nautical-story-duration) step-end both; }
:global(.cp[data-demonstrate='true']) .accepted-result { animation: accepted-result var(--nautical-story-duration) step-end both; }
@keyframes close-boom { 0% {transform:rotate(-60deg);} 16%,100% {transform:rotate(0deg);} }
@keyframes public-test { 0% {offset-distance:0%;} 22%,100% {offset-distance:100%;} }
@keyframes denied-test { 0%,25% {offset-distance:0%;opacity:0;} 26% {opacity:1;offset-distance:0%;} 58%,100% {offset-distance:100%;opacity:1;} }
@keyframes accepted-test { 0%,60% {offset-distance:0%;opacity:0;} 61% {opacity:1;offset-distance:0%;} 94%,100% {offset-distance:100%;opacity:1;} }
@keyframes public-result { 0% {opacity:0;} 22%,100% {opacity:1;} }
@keyframes denied-result { 0% {opacity:0;} 58%,100% {opacity:1;} }
@keyframes accepted-result { 0% {opacity:0;} 94%,100% {opacity:1;} }
</style>
