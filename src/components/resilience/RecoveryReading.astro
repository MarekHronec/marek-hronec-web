---
import { getCollection } from 'astro:content';
import { base } from '../../utils/base';
const ids=['multicloud/regions-zones-availability-domains-where-your-data-lives','multicloud/service-availability-by-region-why-you-cannot-trust-the-map'];
const articles=await getCollection('knowledgeBase');
const reading=ids.map(id=>{const a=articles.find(a=>a.id===id);if(!a)throw new Error('Missing resilience reading: '+id);return a;});
const sources=[
  ['Recovery time, recovery point and availability','https://learn.microsoft.com/en-us/azure/reliability/concept-business-continuity-high-availability-disaster-recovery'],
  ['Recovery planning and exercises','https://learn.microsoft.com/en-us/azure/well-architected/reliability/disaster-recovery'],
  ['Azure region pairing limitations','https://learn.microsoft.com/en-us/azure/reliability/regions-paired'],
  ['OCI regions, availability and fault domains','https://docs.oracle.com/en-us/iaas/Content/General/Concepts/regions.htm'],
];
---
<section class="recovery-reading" aria-labelledby="recovery-reading-title">
  <h2 id="recovery-reading-title">Read the detail behind the decision.</h2>
  <p>These existing notes cover placement and regional service checks. They were reviewed and updated alongside this guide.</p>
  <ul role="list">{reading.map(a=><li><a href={base+'/knowledge-base/'+a.id}>{a.data.title} &rarr;</a><p>{a.data.excerpt}</p></li>)}</ul>
  <aside>
    <h3>Sources &amp; method</h3>
    <p>Reviewed 10 September 2026. The illustrations simplify failure scenarios; the planner translates your stated targets into questions and priorities. It does not calculate achieved RTO, RPO or availability.</p>
    <ul role="list">{sources.map(([label,href])=><li><a href={href}>{label} &rarr;</a></li>)}</ul>
  </aside>
</section>
<style>
  h2 { font: var(--weight-semibold) var(--text-headline-md)/var(--leading-snug) var(--font-display); letter-spacing: var(--tracking-tight); }
  p { margin-top: var(--space-3); max-width: 80ch; color: var(--color-on-surface-muted); line-height: var(--leading-relaxed); }
  ul { display: grid; gap: var(--space-5); margin-top: var(--space-5); }
  a { color: var(--color-navy); font-weight: var(--weight-semibold); }
  aside { margin-top: var(--space-7); padding: var(--space-5); background: var(--color-surface-container-low); }
  h3 { color: var(--color-primary); font: var(--text-label-md) var(--font-mono); }
  aside a, aside p { font-size: var(--text-label-md); }
  @media(min-width:768px){aside ul{grid-template-columns:1fr 1fr;}}
</style>
