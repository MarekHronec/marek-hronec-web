---
import { RESILIENCE_STORIES, type ResilienceKey } from '../../data/resilience-concepts';
import ConceptPanel from '../platform/ConceptPanel.astro';
import RecoveryRoute from './scenes/RecoveryRoute.astro';
import RecoveryPoint from './scenes/RecoveryPoint.astro';
import RecoveryCopies from './scenes/RecoveryCopies.astro';
import FailureDomains from './scenes/FailureDomains.astro';
const scenes = { rto: RecoveryRoute, rpo: RecoveryPoint, copies: RecoveryCopies, domains: FailureDomains } satisfies Record<ResilienceKey, typeof RecoveryRoute>;
---
<div class="resilience-explainer" data-explainer>
  <h2>Four questions before the next outage.</h2>
  <p class="resilience-explainer__lede">Availability describes whether an operation is usable over time. Recovery is how you restore it after disruption. Explore time, data, copies and failure boundaries, then turn those requirements into a recovery brief.</p>
  <div class="resilience-explainer__tabs" role="tablist" aria-label="Recovery concepts" data-needs-js hidden>
    {RESILIENCE_STORIES.map((s,i) => <button type="button" role="tab" id={'concept-tab-'+s.key} aria-controls={'concept-panel-'+s.key} aria-selected={i===0} tabindex={i===0?0:-1} data-tab={s.key}><span>{s.ordinal} / {s.model}</span><strong>{s.name}</strong></button>)}
  </div>
  {RESILIENCE_STORIES.map(story => { const Scene=scenes[story.key]; return <ConceptPanel story={story}><Scene /></ConceptPanel>; })}
</div>
<script>
  import { initializeExplainers } from '../../scripts/explainer';
  initializeExplainers();
  document.addEventListener('astro:page-load', () => initializeExplainers());
</script>
<style>
  h2 { font: var(--weight-semibold) var(--text-headline-md)/var(--leading-snug) var(--font-display); letter-spacing: var(--tracking-tight); }
  .resilience-explainer__lede { max-width: 75ch; margin-block: var(--space-3) var(--space-6); color: var(--color-on-surface-muted); line-height: var(--leading-relaxed); }
  .resilience-explainer__tabs { display: grid; gap: var(--space-2); }
  .resilience-explainer__tabs[hidden] { display: none; }
  button { border: 0; padding: var(--space-4); text-align: left; background: var(--color-surface-container-low); color: var(--color-navy); cursor: pointer; }
  button span { display: block; margin-bottom: var(--space-2); font: var(--text-label-sm) var(--font-mono); }
  button strong { font: var(--weight-semibold) var(--text-label-md) var(--font-body); }
  button[aria-selected='true'] { background: var(--color-navy); color: var(--color-on-primary); }
  .resilience-explainer:not([data-ready]) :global(.scene *) { animation-play-state: paused; }
  @media (min-width: 640px) { .resilience-explainer__tabs { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (min-width: 1024px) { .resilience-explainer__tabs { grid-template-columns: repeat(4,minmax(0,1fr)); } }
</style>
