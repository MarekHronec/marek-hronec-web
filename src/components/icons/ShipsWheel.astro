---
/*
 * Ship's wheel — eight spokes, eight handles, felloe rim.
 * Hand-drawn to match the stroke weight of the other nautical marks;
 * swap in a sourced SVG here if a better one turns up.
 */
interface Props {
  size?: number;
  class?: string;
  'aria-hidden'?: boolean | 'true' | 'false';
}
const { size = 24, class: className, ...rest } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  class={className}
  {...rest}
>
  <circle cx="50" cy="50" r="33" stroke-width="6" />
  <g stroke-width="4">
    <path d="M57 50H86M43 50H14M50 43V14M50 57v29" />
    <path d="M54.95 45.05 75.46 24.54M45.05 45.05 24.54 24.54M45.05 54.95 24.54 75.46M54.95 54.95 75.46 75.46" />
  </g>
  <g stroke-width="5">
    <path d="M86 50h10M14 50H4M50 14V4M50 86v10" />
    <path d="M75.46 24.54 82.53 17.47M24.54 24.54 17.47 17.47M24.54 75.46 17.47 82.53M75.46 75.46 82.53 82.53" />
  </g>
  <circle cx="50" cy="50" r="7" fill="currentColor" stroke="none" />
</svg>
