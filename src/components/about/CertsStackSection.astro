---
/*
 * Certifications + Technical Stack, split by a single vertical hairline
 * instead of two tonal trays. Each credential is sealed with the drafting
 * compass in a ring — the same ring geometry as the process steps above.
 */

import DraftingCompass from "../icons/DraftingCompass.astro";

import { base } from '../../utils/base';

interface Cert {
  name: string;
  level: string;
}

interface TechCategory {
  name: string;
  items: string[];
}

/*
 * A column can hold one or two stacked TechCategory sections.
 * Orchestration + Languages share column 3 so the grid stays at 4 columns
 * instead of spreading to 5.
 */
interface TechColumn {
  sections: TechCategory[];
}

const certifications: Cert[] = [
  { name: "Azure Solutions Architect Expert", level: "Expert Level" },
  { name: "Oracle Cloud Infrastructure Architect", level: "Associate Level" },
  { name: "Oracle Multicloud Architect", level: "Professional Level" },
];

const columns: TechColumn[] = [
  {
    sections: [
      {
        name: "Infrastructure",
        items: [
          "Microsoft Azure",
          "Azure ExpressRoute",
          "Oracle Cloud (OCI)",
          "GitHub",
          "GitHub Actions",
          "Terraform",
        ],
      },
    ],
  },
  {
    sections: [
      {
        name: "Containers",
        items: ["Kubernetes", "Azure App Service", "Docker"],
      },
      { name: "Orchestration", items: ["Camunda BPM", "Oracle BPM"] },
    ],
  },
  {
    sections: [
      {
        name: "Observability",
        items: ["Power BI", "Tableau", "Grafana", "Cloud-native tools"],
      },
    ],
  },
  {
    sections: [
      {
        name: "Modeling",
        items: ["Sparx EA", "BiZZdesign", "Archi", "BPMN Modelers", "draw.io"],
      },
    ],
  },
];
---

<section class="cs section-rule">
  <div class="cs__inner container">
    <div class="cs__certs">
      <p class="cs__label">Certifications</p>
      <ul class="cs__cert-list" role="list">
        {
          certifications.map((cert) => (
            <li class="cs__cert-item">
              <span class="cs__cert-seal" aria-hidden="true">
                <DraftingCompass size={20} />
              </span>
              <div class="cs__cert-text">
                <span class="cs__cert-name">{cert.name}</span>
                <span class="cs__cert-level">{cert.level}</span>
              </div>
            </li>
          ))
        }
      </ul>

      <a class="cs__certs-link" href={`${base}/credentials`}>
        View all certifications
        <svg
          width="12"
          height="12"
          viewBox="0 0 12 12"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M2 6h8M7 3l3 3-3 3"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="cs__stack">
      <p class="cs__label">Technical Stack</p>
      <div class="cs__stack-grid">
        {
          columns.map((col) => (
            <div class="cs__stack-col">
              {col.sections.map((section: TechCategory) => (
                <div class="cs__stack-section">
                  <h3 class="cs__stack-heading">
                    {section.name.toUpperCase()}
                  </h3>
                  <ul class="cs__stack-items" role="list">
                    {section.items.map((item: string) => (
                      <li class="cs__stack-item">{item}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .cs__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    padding-block: var(--space-7);
  }

  @media (min-width: 768px) {
    .cs__inner {
      /* 340px cert column is wide enough that long cert names don't wrap */
      grid-template-columns: 340px 1fr;
      gap: 0;
    }
  }

  .cs__certs {
    display: flex;
    flex-direction: column;
  }

  /* The hairline that used to be a tonal tray edge */
  @media (min-width: 768px) {
    .cs__certs {
      padding-right: var(--space-6);
    }

    .cs__stack {
      padding-left: var(--space-7);
      border-left: 1px solid var(--color-divider);
    }
  }

  .cs__label {
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-on-surface);
    margin-bottom: var(--space-6);
  }

  .cs__label::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-top: var(--space-3);
    background-color: var(--color-primary);
  }

  .cs__cert-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .cs__cert-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* Ring seal — same geometry as the process steps, two stops smaller */
  .cs__cert-seal {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border: 1px solid var(--color-divider-strong);
    border-radius: var(--radius-full);
    color: var(--color-primary);
  }

  .cs__cert-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .cs__cert-name {
    font-family: var(--font-body);
    font-size: var(--text-body-md);
    font-weight: var(--weight-semibold);
    color: var(--color-on-surface);
    line-height: var(--leading-snug);
  }

  .cs__cert-level {
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    color: var(--color-on-surface-muted);
  }

  .cs__stack-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--space-5);
    row-gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .cs__stack-grid {
      grid-template-columns: repeat(3, 1fr);
      column-gap: var(--space-5);
    }
  }

  @media (min-width: 1024px) {
    .cs__stack-grid {
      grid-template-columns: repeat(4, 1fr);
      column-gap: var(--space-5);
      row-gap: var(--space-4);
    }
  }

  .cs__stack-section {
    margin-bottom: var(--space-5);
  }

  .cs__stack-section:last-child {
    margin-bottom: 0;
  }

  .cs__stack-heading {
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }

  .cs__stack-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cs__stack-item {
    font-family: var(--font-body);
    font-size: var(--text-body-md);
    color: var(--color-on-surface-muted);
    line-height: var(--leading-snug);
  }

  .cs__certs-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: auto;
    padding-top: var(--space-6);
    align-self: flex-end;
    font-family: var(--font-display);
    font-size: var(--text-label-md);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
    text-decoration: none;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .cs__certs-link:hover {
    opacity: 0.75;
  }
</style>
