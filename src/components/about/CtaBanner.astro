---
/*
 * Navy plate closing the page. The lighthouse is a flex item rather than an
 * absolutely-positioned watermark, so the plate edge can never clip it and it
 * holds its own column in the row. It drops out below 768px, where the plate
 * goes single-column and there is no room beside the copy.
 */

import { base } from '../../utils/base';
import Lighthouse from '../icons/Lighthouse.astro';
---

<section class="cta-section">
  <div class="cta-section__container container">
    <div class="cta-banner">
      <Lighthouse size={104} class="cta-banner__mark" aria-hidden="true" />

      <div class="cta-banner__content">
        <h2 class="cta-banner__heading">Let's simplify the complex.</h2>
        <p class="cta-banner__body">
          From architecture reviews to cloud strategy, I help turn
          complexity into clear and practical decisions.
        </p>
      </div>

      <a class="cta-banner__button" href={`${base}/contact`}>
        Schedule a Consultation
        <svg width="13" height="13" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M2 6h8M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding-block: 0 var(--space-8);
  }

  .cta-section__container {
    padding-inline: var(--gutter);
  }

  .cta-banner {
    background-color: var(--color-navy);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .cta-banner {
      flex-direction: row;
      align-items: center;
      gap: var(--space-7);
      padding: var(--space-8) var(--space-10);
    }
  }

  .cta-banner__mark {
    display: none;
  }

  /*
   * 1024, not 768: between those widths the row is only just wide enough for
   * the copy and the button, and a third item crushes the heading to four lines.
   */
  @media (min-width: 1024px) {
    .cta-banner__mark {
      display: block;
      flex-shrink: 0;
      color: var(--color-on-dark-muted);
    }
  }

  .cta-banner__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 52ch;
  }

  /* margin-right rather than justify-content: space-between, which would also
     space out the lighthouse and leave it stranded */
  @media (min-width: 768px) {
    .cta-banner__content {
      margin-right: auto;
    }
  }

  .cta-banner__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, var(--text-headline-md));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-on-inverse-surface);
    line-height: var(--leading-tight);
  }

  .cta-banner__body {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-on-dark-muted);
  }

  /* Outlined on the plate — a filled button would flatten against the navy */
  .cta-banner__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
    flex-shrink: 0;
    padding: var(--space-3) var(--space-7);
    border: 1px solid var(--color-on-dark-border);
    background-color: transparent;
    color: var(--color-on-cta);
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-xs);
    transition:
      background-color var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  .cta-banner__button:hover {
    opacity: 1;
    background-color: var(--color-on-inverse-surface);
    color: var(--color-navy);
  }
</style>
