---
/*
 * The process band: three connected steps on paper, disciplines on the navy
 * plate. Both stay inside .container — only the header and footer are
 * full-bleed. The hairline above the band comes from .section-rule, which
 * spans the container's content width rather than the viewport.
 * align-items: stretch keeps the plate the full height of the steps beside it.
 */

import HowIWork from './HowIWork.astro';
import CoreExpertise from './CoreExpertise.astro';
---

<section class="narrative section-rule">
  <div class="narrative__inner container">
    <HowIWork />
    <CoreExpertise />
  </div>
</section>

<style>
  .narrative__inner {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  /*
   * Splits at 1024, not 768: below that the left column is too narrow to hold
   * three step columns without the body copy breaking to two words a line.
   */
  @media (min-width: 1024px) {
    .narrative__inner {
      grid-template-columns: 1fr minmax(300px, 360px);
      column-gap: var(--space-6);
    }
  }

  @media (min-width: 1280px) {
    .narrative__inner {
      column-gap: var(--space-8);
    }
  }
</style>
