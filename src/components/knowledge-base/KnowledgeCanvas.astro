---
import type { CanvasNode, CanvasEdge } from '../../scripts/canvas';

interface Props {
  nodes: CanvasNode[];
  edges: CanvasEdge[];
}

const { nodes, edges } = Astro.props;
---

<div
  id="kb-canvas-wrapper"
  class="kbc-wrapper"
  data-nodes={JSON.stringify(nodes)}
  data-edges={JSON.stringify(edges)}
  hidden
>
  <!-- ── Toolbar — absolute overlay at top of canvas ──────────────────── -->
  <div class="kbc-toolbar" role="toolbar" aria-label="Map controls">
    <div class="kbc-toolbar__left">
      <button id="kbc-filter-all" class="kbc-toolbar__filter kbc-toolbar__filter--active" data-filter="all" title="Show all nodes">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
        All
      </button>

      <div class="kbc-toolbar__sep" aria-hidden="true"></div>

      <button class="kbc-toolbar__filter" data-filter="cloud-reality" title="Highlight Cloud Reality & Thinking">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
        Cloud Reality
      </button>

      <button class="kbc-toolbar__filter" data-filter="governance" title="Highlight Platform Organisation & Governance">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Governance
      </button>

      <button class="kbc-toolbar__filter" data-filter="network" title="Highlight Network Architecture">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        Network
      </button>
    </div>

    <div class="kbc-toolbar__right">
      <button id="kbc-fit" class="kbc-toolbar__btn" title="Fit visible nodes to canvas">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
        Fit
      </button>

      <div id="kbc-search-wrap" class="kbc-search-wrap">
        <button id="kbc-search-toggle" class="kbc-toolbar__btn kbc-search-wrap__toggle">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="6" cy="6" r="4.5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M9.5 9.5L13 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          Search
        </button>
        <div class="kbc-search-wrap__field">
          <input
            id="kbc-search-input"
            class="kbc-search-wrap__input"
            type="text"
            placeholder="Search nodes…"
            autocomplete="off"
            spellcheck="false"
          />
          <button id="kbc-search-clear" class="kbc-search-wrap__clear" aria-label="Clear search">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="none" aria-hidden="true">
              <path d="M1 1l6 6M7 1L1 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Graph surface — fills full wrapper; Cytoscape mounts here -->
  <div id="kb-canvas" class="kbc-surface" aria-label="Knowledge map" role="img"></div>

  <!-- Detail panel — populated by canvas.ts on node click -->
  <aside id="kbc-panel" class="kbc-panel" hidden></aside>

  <!-- Zoom controls: +  100%  − -->
  <div class="kbc-controls" aria-label="Zoom controls">
    <button id="kbc-zoom-in" class="kbc-controls__btn" title="Zoom in">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M6 2v8M2 6h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    <span id="kbc-zoom-pct" class="kbc-controls__pct">100%</span>
    <button id="kbc-zoom-out" class="kbc-controls__btn" title="Zoom out">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2 6h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Legend — two-row compact box -->
  <div class="kbc-legend" aria-label="Map legend">
    <div class="kbc-legend__row">
      <span class="kbc-legend__label">Paths:</span>
      <span class="kbc-legend__item kbc-legend__item--path">Learning path</span>
      <span class="kbc-legend__item kbc-legend__item--related">Related</span>
    </div>
    <div class="kbc-legend__row">
      <span class="kbc-legend__label">Difficulty:</span>
      <span class="kbc-legend__diff">
        <span class="kbc-legend__dot kbc-legend__dot--on"></span><span class="kbc-legend__dot"></span><span class="kbc-legend__dot"></span>
        Foundational
      </span>
      <span class="kbc-legend__diff">
        <span class="kbc-legend__dot kbc-legend__dot--on"></span><span class="kbc-legend__dot kbc-legend__dot--on"></span><span class="kbc-legend__dot"></span>
        Intermediate
      </span>
      <span class="kbc-legend__diff">
        <span class="kbc-legend__dot kbc-legend__dot--on"></span><span class="kbc-legend__dot kbc-legend__dot--on"></span><span class="kbc-legend__dot kbc-legend__dot--on"></span>
        Advanced
      </span>
    </div>
  </div>
</div>

<!-- ── Structural styles ─────────────────────────────────────────────────── -->
<style>
  .kbc-wrapper {
    position: relative;
    width: 100%;
    height: calc(100vh - 14rem);
    min-height: 520px;
    background: var(--color-surface-container-low);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .kbc-wrapper[hidden] { display: none; }

  /* Canvas fills the full wrapper; toolbar/controls/legend overlay it */
  .kbc-surface {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-tap-highlight-color: transparent;
    outline: none;
    user-select: none;
  }

  /* ── Toolbar — transparent strip; each button is its own floating pill ── */
  .kbc-toolbar {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
    pointer-events: none;
  }

  .kbc-toolbar__left,
  .kbc-toolbar__right {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex-wrap: wrap;
    pointer-events: auto;
  }

  .kbc-toolbar__sep {
    width: 1px;
    height: 16px;
    background: var(--color-warm-gray-20);
    flex-shrink: 0;
    margin-inline: 2px;
    opacity: 0;
  }

  .kbc-toolbar__btn,
  .kbc-toolbar__filter {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.01em;
    cursor: pointer;
    white-space: nowrap;
    color: var(--color-on-surface-muted);
    background: rgba(252, 249, 248, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 4px rgba(50, 50, 50, 0.09);
    transition: background-color var(--duration-fast) var(--ease-standard),
                color var(--duration-fast) var(--ease-standard);
  }

  .kbc-toolbar__btn:hover,
  .kbc-toolbar__filter:hover {
    color: var(--color-on-surface);
    background: rgba(252, 249, 248, 0.97);
  }
  .kbc-toolbar__filter--active,
  .kbc-toolbar__filter--active:hover {
    color: var(--color-primary);
    background: var(--color-cta-surface);
  }

  /* ── Search ───────────────────────────────────────────────────────── */
  .kbc-search-wrap { position: relative; }

  .kbc-search-wrap__field {
    display: none;
    position: relative;
    align-items: center;
  }
  .kbc-search-wrap--open .kbc-search-wrap__toggle { display: none; }
  .kbc-search-wrap--open .kbc-search-wrap__field  { display: flex; }

  .kbc-search-wrap__input {
    width: 190px;
    padding: 5px 28px 5px 12px;
    border-radius: var(--radius-full);
    background: rgba(252, 249, 248, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 4px rgba(50, 50, 50, 0.09);
    border: none;
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    color: var(--color-on-surface);
    outline: none;
  }
  .kbc-search-wrap__input:focus {
    box-shadow: 0 0 0 2px rgba(44, 105, 78, 0.25), 0 1px 4px rgba(50, 50, 50, 0.09);
  }

  .kbc-search-wrap__clear {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    display: none;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-warm-gray-20);
    color: var(--color-on-surface-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }
  .kbc-search-wrap__clear:hover { background: var(--color-warm-gray-30); }
  .kbc-search-wrap--has-text .kbc-search-wrap__clear { display: flex; }

  /* ── Detail panel ─────────────────────────────────────────────────── */
  .kbc-panel {
    position: absolute;
    top: 70px;
    right: var(--space-4);
    width: 288px;
    max-height: calc(100% - 70px - var(--space-8));
    overflow-y: auto;
    background: var(--color-surface-container-lowest);
    box-shadow: var(--shadow-float);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    z-index: 10;
  }

  .kbc-panel[hidden] { display: none; }

  .kbc-panel :global(.kbc-panel__header-label) {
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    font-weight: var(--weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .kbc-panel :global(.kbc-panel__close) {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: var(--color-surface-container-low);
    color: var(--color-on-surface-muted);
    cursor: pointer;
    flex-shrink: 0;
    transition: background-color var(--duration-fast) var(--ease-standard);
  }
  .kbc-panel :global(.kbc-panel__close:hover) { background: var(--color-surface-container); }

  .kbc-panel :global(.kbc-panel__title) {
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    font-weight: var(--weight-bold);
    color: var(--color-on-surface);
    line-height: var(--leading-snug);
    padding-right: var(--space-4);
  }

  .kbc-panel :global(.kbc-panel__excerpt) {
    font-size: var(--text-body-md);
    line-height: var(--leading-relaxed);
    color: var(--color-on-surface-muted);
  }

  .kbc-panel :global(.kbc-panel__tags) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .kbc-panel :global(.kbc-panel__tag) {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--space-2);
    background: var(--color-surface-container);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--text-label-sm);
    font-weight: var(--weight-bold);
    letter-spacing: 0.06em;
    color: var(--color-on-surface-muted);
  }

  .kbc-panel :global(.kbc-panel__link) {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-body);
    font-size: var(--text-body-md);
    font-weight: var(--weight-semibold);
    color: var(--color-primary);
    text-decoration: none;
    margin-top: var(--space-1);
  }
  .kbc-panel :global(.kbc-panel__link:hover) { text-decoration: underline; }

  /* ── Zoom controls — unified segmented pill ──────────────────────── */
  .kbc-controls {
    position: absolute;
    bottom: var(--space-5);
    left: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    z-index: 10;
    background: rgba(252, 249, 248, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-sm);
    box-shadow: 0 1px 4px rgba(50, 50, 50, 0.09);
    overflow: hidden;
  }

  .kbc-controls__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 28px;
    background: transparent;
    color: var(--color-on-surface-muted);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard),
                background-color var(--duration-fast) var(--ease-standard);
  }
  .kbc-controls__btn:hover {
    color: var(--color-primary);
    background: rgba(44, 105, 78, 0.07);
  }

  .kbc-controls__pct {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--weight-semibold);
    color: var(--color-on-surface-muted);
    background: transparent;
    width: 32px;
    text-align: center;
    padding: 4px 2px;
    letter-spacing: -0.02em;
    border-top: 1px solid rgba(179, 178, 177, 0.25);
    border-bottom: 1px solid rgba(179, 178, 177, 0.25);
  }

  /* ── Legend — two-row compact box ────────────────────────────────── */
  .kbc-legend {
    position: absolute;
    bottom: var(--space-5);
    right: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: rgba(252, 249, 248, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    box-shadow: 0 1px 4px rgba(50, 50, 50, 0.09);
    z-index: 10;
  }

  .kbc-legend__row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .kbc-legend__label {
    font-family: var(--font-body);
    font-size: var(--text-label-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-on-surface-muted);
    letter-spacing: 0.03em;
    white-space: nowrap;
    min-width: 58px;
  }

  .kbc-legend__item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    color: var(--color-on-surface-muted);
  }

  .kbc-legend__item::before {
    content: '';
    display: block;
    width: 22px;
    height: 2px;
    flex-shrink: 0;
  }
  .kbc-legend__item--path::before { background: var(--color-primary); }
  .kbc-legend__item--related::before {
    background: repeating-linear-gradient(
      90deg, var(--color-warm-gray) 0, var(--color-warm-gray) 5px, transparent 5px, transparent 9px
    );
  }

  .kbc-legend__diff {
    display: flex;
    align-items: center;
    gap: 3px;
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    color: var(--color-on-surface-muted);
  }

  .kbc-legend__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-warm-gray-30);
    border: 1px solid var(--color-warm-gray);
    flex-shrink: 0;
  }
  .kbc-legend__dot--on {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }
  .kbc-legend__diff .kbc-legend__dot:last-of-type { margin-right: 4px; }
</style>

<!-- ── Global styles for HTML node labels injected by Cytoscape ──────────── -->
<style is:global>
  /* Article node — must match canvas.ts width:340 height:78 */
  .kbc-node {
    width: 340px;
    height: 78px;
    box-sizing: border-box;
    padding: 0 12px 0 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    pointer-events: none;
    position: relative;
    overflow: visible;
  }

  /* Group header — must match canvas.ts width:340 height:50 */
  .kbc-node--group {
    width: 340px;
    height: 50px;
    padding: 0 14px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 9px;
  }

  /* Icon + title row inside article nodes */
  .kbc-node__row {
    display: flex;
    gap: 10px;
    align-items: center;
    width: 100%;
  }

  .kbc-node__icon-wrap {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kbc-node__icon-wrap svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  /* START HERE badge */
  .kbc-node__start {
    position: absolute;
    top: -26px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-body);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  /* Article title */
  .kbc-node__title {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: #323232;
    line-height: 1.35;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    flex: 1;
  }

  /* Group header label */
  .kbc-node__group-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.03em;
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .kbc-node--group[data-branch="cloud-reality"] .kbc-node__group-label { color: #2c694e; }
  .kbc-node--group[data-branch="governance"]    .kbc-node__group-label { color: #3e6daa; }
  .kbc-node--group[data-branch="network"]       .kbc-node__group-label { color: #6354a8; }

  /* Difficulty dots — absolute bottom-right of card */
  .kbc-node__dots {
    position: absolute;
    bottom: 7px;
    right: 10px;
    display: flex;
    gap: 3px;
    align-items: center;
  }

  .kbc-node__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(179, 178, 177, 0.35);
    border: 1px solid rgba(179, 178, 177, 0.6);
    flex-shrink: 0;
  }

  .kbc-node[data-branch="cloud-reality"] .kbc-node__dot--filled { background: #2c694e; border-color: #2c694e; }
  .kbc-node[data-branch="governance"]    .kbc-node__dot--filled { background: #3e6daa; border-color: #3e6daa; }
  .kbc-node[data-branch="network"]       .kbc-node__dot--filled { background: #6354a8; border-color: #6354a8; }
  .kbc-node[data-branch=""]             .kbc-node__dot--filled { background: #2c694e; border-color: #2c694e; }

  /* ── Atom click indicator ──────────────────────────────────────────── */
  .kbc-atom {
    position: absolute;
    width: 70px;
    height: 70px;
    pointer-events: none;
    z-index: 100;
    transform-origin: center;
  }

  .kbc-atom__nucleus {
    position: absolute;
    left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    width: 8px; height: 8px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, rgba(44,105,78,0.95), rgba(44,105,78,0.45));
    box-shadow: 0 0 5px rgba(44,105,78,0.5), 0 0 12px rgba(44,105,78,0.18);
  }

  .kbc-atom__nucleus::after {
    content: '';
    position: absolute;
    left: 50%; top: 50%;
    width: 8px; height: 8px;
    border-radius: 50%;
    border: 1.5px solid rgba(44,105,78,0.55);
    transform: translate(-50%,-50%) scale(1);
    animation: kbc-atom-ping 1.4s ease-out infinite;
    transition: opacity 0.35s ease;
  }

  .kbc-atom--active .kbc-atom__nucleus::after { animation: none; opacity: 0; }

  @keyframes kbc-atom-ping {
    0%   { transform: translate(-50%,-50%) scale(1);   opacity: 0.7; }
    100% { transform: translate(-50%,-50%) scale(5.5); opacity: 0;   }
  }

  .kbc-atom__ring {
    position: absolute;
    left: 50%; top: 50%;
    width: 52px; height: 18px;
    margin-left: -26px; margin-top: -9px;
    border: 1px solid rgba(44,105,78,0.22);
    border-radius: 50%;
    opacity: 0;
    transform: rotate(var(--ring-angle, 0deg)) scale(0.15);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.2,0.8,0.2,1);
  }
  .kbc-atom--active .kbc-atom__ring { opacity: 1; transform: rotate(var(--ring-angle, 0deg)) scale(1); }
  .kbc-atom--active .kbc-atom__ring:nth-child(2) { transition-delay: 0s;    }
