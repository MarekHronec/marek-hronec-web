---
const phases = [
  ['Classify the data', 'Choose C, I and A'],
  ['Describe the impact', 'Assess a credible incident'],
  ['Review the requirements', 'Confirm criteria and read the result'],
];
---
<header class="assessment-guide">
  <h2>Classify your system</h2>
  <p>Choose one answer for each property below. Your answers then unlock the incident assessment and hosting requirements.</p>
  <ol role="list" aria-label="Assessment stages">
    {phases.map(([title, detail], index) => (
      <li data-assessment-phase={index + 1} data-current={index === 0 ? 'true' : 'false'} aria-current={index === 0 ? 'step' : undefined}>
        <span class="assessment-guide__number" aria-hidden="true">{index + 1}</span>
        <div><strong>{title}</strong><span>{detail}</span></div>
      </li>
    ))}
  </ol>
</header>
<style>
  .assessment-guide { margin-top: var(--space-6); }
  h2 { font: var(--weight-semibold) var(--text-headline-md) / var(--leading-snug) var(--font-display); letter-spacing: var(--tracking-tight); color: var(--color-navy); }
  p { margin-block: var(--space-3) var(--space-5); font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--color-on-surface-muted); max-width: 72ch; }
  ol { display: grid; gap: var(--space-2); }
  li { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); background: var(--color-surface-container-low); }
  li[data-current="true"] { background: var(--color-primary-tint); }
  .assessment-guide__number { font: var(--text-title-lg) var(--font-mono); color: var(--color-primary); }
  strong { display: block; font-size: var(--text-body-md); font-weight: var(--weight-semibold); color: var(--color-navy); }
  li div > span { display: block; margin-top: var(--space-1); font-size: var(--text-label-md); color: var(--color-on-surface-muted); }
  @media (min-width: 768px) { ol { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>

