---
/*
 * What C, I, A and U mean — four diagrams, one per concept.
 *
 *   C — a harbour boom closing: boats are turned away one ring at a time
 *       until only the named one still reaches the hold
 *   I — the chart records 12 fathoms, the rock is at 3. The instrument is
 *       fine, the recorded value is not, and the ship grounds on the gap
 *   A — a lighthouse beam sweeping, then going dark, leaving the ship adrift
 *   U — C, I and A decide which berths may accept the ship. A higher
 *       classification does not burden the asset, it narrows where it may go
 *
 * Inline SVG with CSS keyframes: no library, no raster, scales to any width,
 * themes through the colour tokens. A JS animation runtime would cost ~30kB
 * on a site whose default is zero client-side JS.
 *
 * Two conventions hold throughout, both learned the hard way:
 *   - anything animated with translate+rotate/scale carries
 *     `transform-box: view-box; transform-origin: 0 0`, or it pivots about
 *     the view-box centre and lands tens of units away from its keyframe
 *   - every travelling object fades out at the end of its journey and fades
 *     back in at the start, so the loop never visibly rewinds across frame
 */

const TABS = [
  { key: 'c', letter: 'C', name: 'Confidentiality', sk: 'Dôvernosť' },
  { key: 'i', letter: 'I', name: 'Integrity', sk: 'Integrita' },
  { key: 'a', letter: 'A', name: 'Availability', sk: 'Dostupnosť' },
  { key: 'u', letter: 'U', name: 'Service level', sk: 'Úroveň služby' },
];

/* Boats on an arc of radius 130 about the hold at (200,152). `ring` is the
   order they are turned away in as the boom closes; ring 1 is never refused. */
const BOATS = [
  { x: 70,  y: 152, a: 180, ring: 4 },
  { x: 93,  y: 77,  a: 145, ring: 3 },
  { x: 156, y: 30,  a: 110, ring: 2 },
  { x: 200, y: 22,  a: 90,  ring: 1 },
  { x: 244, y: 30,  a: 70,  ring: 2 },
  { x: 307, y: 77,  a: 35,  ring: 3 },
  { x: 330, y: 152, a: 0,   ring: 4 },
];

const BERTHS = [
  { x: 62,  u: 1, wall: false, gate: false, tower: false },
  { x: 154, u: 2, wall: true,  gate: false, tower: false },
  { x: 246, u: 3, wall: true,  gate: true,  tower: false },
  { x: 338, u: 4, wall: true,  gate: true,  tower: true  },
];
---

<div class="ex">
  <div class="ex__head">
    <h3 class="ex__title">Reading the result: C, I, A and U</h3>
    <p class="ex__lede">
      Three questions about an asset, and one answer. Pick a letter to see what it means.
    </p>
  </div>

  <div class="ex__tabs" role="tablist" aria-label="Classification parameters">
    {TABS.map((t, i) => (
      <button
        type="button"
        role="tab"
        class:list={['ex__tab', { 'ex__tab--active': i === 0 }]}
        id={`ex-tab-${t.key}`}
        aria-controls={`ex-panel-${t.key}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        data-tab={t.key}
      >
        <span class="ex__tab-letter">{t.letter}</span>
        <span class="ex__tab-name">{t.name}</span>
        <span class="ex__tab-sk">{t.sk}</span>
      </button>
    ))}
  </div>

  <div class="ex__stage">

    <!-- ── C — the boom closes, boats are turned away ─────────────────── -->
    <section class="ex__panel ex__panel--active" id="ex-panel-c" role="tabpanel" aria-labelledby="ex-tab-c" data-panel="c">
      <svg class="ex__svg" viewBox="0 0 400 240" role="img" aria-label="A harbour boom closing ring by ring, turning boats away until only one still reaches the hold">
        {BOATS.map((b) => (
          <line class={`exc__line exc__line--r${b.ring}`} x1={b.x} y1={b.y} x2="200" y2="152" />
        ))}

        <circle class="exc__boom" cx="200" cy="152" r="142" />

        {BOATS.map((b) => (
          <g transform={`translate(${b.x} ${b.y})`}>
            <g
              class={`exc__boat exc__boat--r${b.ring}`}
              style={`--turn-x:${(Math.cos((b.a * Math.PI) / 180) * 26).toFixed(1)}px; --turn-y:${(-Math.sin((b.a * Math.PI) / 180) * 26).toFixed(1)}px;`}
            >
              <path d="M-10 3 H10 L7 10 H-7 Z" />
              <line x1="0" y1="3" x2="0" y2="-8" />
            </g>
          </g>
        ))}

        <rect class="exc__hold" x="178" y="132" width="44" height="38" />
        <circle class="exc__lock" cx="200" cy="148" r="4.5" />
        <line class="exc__lock-stem" x1="200" y1="150" x2="200" y2="160" />

        <text class="ex__cap ex__cap--c0" x="200" y="222">C0 — public. Anyone may come alongside.</text>
        <text class="ex__cap ex__cap--c3" x="200" y="222">C3 — strictly protected. Named individuals only.</text>
      </svg>
      <div class="ex__copy">
        <h4>Who is allowed to see it</h4>
        <p>
          Confidentiality asks how damaging a leak would be, which in practice is a
          question about how far the boom is closed. Public data lets everyone
          alongside. Strictly protected data admits named individuals and turns the
          rest away.
        </p>
      </div>
    </section>

    <!-- ── I — the chart is wrong ─────────────────────────────────────── -->
    <section class="ex__panel" id="ex-panel-i" role="tabpanel" aria-labelledby="ex-tab-i" data-panel="i" hidden>
      <svg class="ex__svg" viewBox="0 0 400 240" role="img" aria-label="A chart records twelve fathoms where the rock is actually at three, and the ship grounds on the difference">
        <!-- what the record says -->
        <g class="exi__chart">
          <rect x="18" y="16" width="116" height="60" />
          <text class="exi__chart-label" x="32" y="36">CHARTED DEPTH</text>
          <text class="exi__reading" x="32" y="66">12</text>
          <text class="exi__unit" x="72" y="66">fathoms</text>
          <line class="exi__strike" x1="28" y1="57" x2="66" y2="57" />
        </g>

        <!-- sea, seabed, and the rock the chart never recorded -->
        <path class="exi__sea" d="M0 116 q 25 -6 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0" />
        <path class="exi__bed" d="M0 214 H232 C 262 214, 272 140, 300 140 C 328 140, 338 214, 400 214 V240 H0 Z" />

        <!-- the depth that is actually there -->
        <g class="exi__truth">
          <line x1="336" y1="118" x2="336" y2="158" />
          <path d="M336 158 l-4.5 -7 h9 z" />
          <text x="348" y="152">3</text>
        </g>

        <g class="exi__ship">
          <path d="M-16 0 H16 L11 11 H-11 Z" />
          <line x1="0" y1="0" x2="0" y2="-19" />
          <path d="M0 -18 L13 -11 L0 -4 Z" />
        </g>
        <g class="exi__impact">
          <line x1="-11" y1="-11" x2="11" y2="11" />
          <line x1="11" y1="-11" x2="-11" y2="11" />
        </g>

        <text class="ex__cap ex__cap--i0" x="200" y="232">The chart reads 12. Nothing looks wrong.</text>
        <text class="ex__cap ex__cap--i1" x="200" y="232">The rock is at 3. The record was never corrected.</text>
      </svg>
      <div class="ex__copy">
        <h4>Whether the data can be trusted</h4>
        <p>
          Integrity is not about outages. The chart is legible, the system is up, and
          the depth it records is simply wrong — so the ship sails a route that looks
          safe and grounds anyway. High integrity means an error in the data would
          immediately threaten the service that relies on it.
        </p>
      </div>
    </section>

    <!-- ── A — the light goes out ─────────────────────────────────────── -->
    <section class="ex__panel" id="ex-panel-a" role="tabpanel" aria-labelledby="ex-tab-a" data-panel="a" hidden>
      <svg class="ex__svg" viewBox="0 0 400 240" role="img" aria-label="A lighthouse beam sweeping across the water, then going dark and leaving a ship to drift toward the rocks">
        <g class="exa__beam">
          <path d="M100 78 L372 40 L372 116 Z" />
        </g>

        <g class="exa__tower">
          <path class="exa__rock" d="M56 196 q 44 -28 88 0 z" />
          <path d="M86 196 L90 96 H110 L114 196 Z" />
          <path class="exa__gallery" d="M83 96 H117" />
          <rect class="exa__lamp" x="90" y="66" width="20" height="30" />
          <path d="M85 66 L100 50 L115 66 Z" />
        </g>
        <g class="exa__glow"><circle cx="100" cy="78" r="17" /></g>
        <circle class="exa__light" cx="100" cy="78" r="6" />

        <!-- the hazard the light exists to keep ships off -->
        <path class="exa__shoal" d="M330 200 q 26 -22 52 0 z" />

        <path class="exa__sea" d="M0 200 q 25 -6 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0" />
        <g class="exa__ship">
          <path d="M-15 0 H15 L11 11 H-11 Z" />
          <line x1="0" y1="0" x2="0" y2="-19" />
          <path d="M0 -18 L12 -11 L0 -4 Z" />
        </g>

        <text class="ex__cap ex__cap--a0" x="200" y="232">A1 — the light holds, or something else guides the ship.</text>
        <text class="ex__cap ex__cap--a1" x="200" y="232">A3 — the light is out and nothing replaces it.</text>
      </svg>
      <div class="ex__copy">
        <h4>Whether it is there when needed</h4>
        <p>
          Availability asks what an outage costs. If people can still reach the service
          another way, the light going out is survivable. If nothing replaces it, the
          asset is critical and an outage stops the essential service outright.
        </p>
      </div>
    </section>

    <!-- ── U — which berths may accept it ─────────────────────────────── -->
    <section class="ex__panel" id="ex-panel-u" role="tabpanel" aria-labelledby="ex-tab-u" data-panel="u" hidden>
      <svg class="ex__svg" viewBox="0 0 400 240" role="img" aria-label="A ship carrying a classification is refused by the two least assured berths and accepted at the third">
        <path class="exu__sea" d="M0 108 q 25 -5 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0" />

        {BERTHS.map((b) => (
          <g class={`exu__berth exu__berth--${b.u}`} transform={`translate(${b.x} 0)`}>
            <rect class="exu__slot" x="-36" y="96" width="72" height="76" />
            <line class="exu__quay" x1="-36" y1="172" x2="36" y2="172" />
            {b.wall  && <path class="exu__wall"  d="M-36 172 V138 M36 172 V138" />}
            {b.gate  && <path class="exu__gate"  d="M-36 138 H-19 M19 138 H36" />}
            {b.tower && <path class="exu__tower" d="M-7 138 h14 v-20 h-14 z M0 118 v-10" />}
            <text class="exu__label" x="0" y="192">U{b.u}</text>
          </g>
        ))}

        {[0, 1].map((i) => (
          <g class={`exu__refuse exu__refuse--${i}`}>
            <line x1="-14" y1="-14" x2="14" y2="14" />
            <line x1="14" y1="-14" x2="-14" y2="14" />
          </g>
        ))}

        <g class="exu__ship">
          <line class="exu__mast" x1="0" y1="-30" x2="0" y2="-58" />
          <path d="M-25 -30 H25 L19 -9 H-19 Z" />
          <g class="exu__badge">
            <rect x="-33" y="-54" width="66" height="22" />
            <text x="0" y="-39">C2 I2 A2</text>
          </g>
        </g>

        <text class="ex__cap ex__cap--u0" x="200" y="226">U1 and U2 are not assured enough to take it.</text>
        <text class="ex__cap ex__cap--u1" x="200" y="226">U3 is the lowest berth allowed to accept it.</text>
      </svg>
      <div class="ex__copy">
        <h4>Which environments may host it</h4>
        <p>
          U is the only value you do not choose. C, I and A together decide how well
          protected a berth has to be before it may take the ship, and the less assured
          berths are simply closed to it. The result is a floor, not a burden: U1 to U4
          is the minimum level a Government Cloud service must hold to host the asset.
        </p>
      </div>
    </section>
  </div>
</div>

<script>
  // Scoped per instance, so a second explainer on a page cannot cross-wire this one.
  document.querySelectorAll<HTMLElement>('.ex').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('.ex__tab');
    const panels = root.querySelectorAll<HTMLElement>('.ex__panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const key = tab.dataset.tab;
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('ex__tab--active', on);
          t.setAttribute('aria-selected', String(on));
        });
        panels.forEach((p) => {
          const on = p.dataset.panel === key;
          p.hidden = !on;
          // Removing then re-adding restarts the panel's keyframes from the top.
          p.classList.remove('ex__panel--active');
          if (on) void p.offsetWidth;
          p.classList.toggle('ex__panel--active', on);
        });
      });
    });
  });
</script>

<style>
  .ex {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: var(--space-6);
  }

  .ex__title {
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-on-surface);
  }

  .ex__lede {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-on-surface-muted);
    margin-top: var(--space-2);
    max-width: 68ch;
  }

  /* ── Tabs ──────────────────────────────────────────────────────────── */
  .ex__tabs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  @media (min-width: 768px) {
    .ex__tabs { grid-template-columns: repeat(4, 1fr); }
  }

  .ex__tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    background: none;
    border: 1px solid var(--color-divider);
    cursor: pointer;
    text-align: left;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .ex__tab:hover { background-color: var(--color-surface-container-low); }

  .ex__tab--active {
    border-color: var(--color-primary);
    background-color: var(--color-primary-tint);
  }

  .ex__tab-letter {
    font-family: var(--font-mono);
    font-size: var(--text-title-md);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
  }

  .ex__tab-name {
    font-size: var(--text-body-md);
    font-weight: var(--weight-semibold);
    color: var(--color-on-surface);
  }

  .ex__tab-sk {
    font-size: var(--text-label-md);
    font-style: italic;
    color: var(--color-on-surface-muted);
  }

  /* ── Stage ─────────────────────────────────────────────────────────── */
  .ex__panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    border: 1px solid var(--color-divider);
    padding: var(--space-4);
  }

  .ex__panel[hidden] { display: none; }

  @media (min-width: 1024px) {
    .ex__panel {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
      column-gap: var(--space-7);
    }
  }

  .ex__svg { width: 100%; height: auto; display: block; }

  .ex__copy h4 {
    font-family: var(--font-display);
    font-size: var(--text-title-md);
    font-weight: var(--weight-semibold);
    color: var(--color-on-surface);
    margin-bottom: var(--space-3);
  }

  .ex__copy p {
    font-size: var(--text-body-md);
    line-height: var(--leading-relaxed);
    color: var(--color-on-surface-muted);
  }

  /* ── Shared SVG vocabulary ─────────────────────────────────────────── */
  .ex__cap {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
    fill: var(--color-meta-label);
    text-anchor: middle;
    opacity: 0;
  }

  /* Travelling objects pivot about their own origin, not the view box.
     .exc__boat is nested inside a positioning group, so its translate is
     relative and needs no origin fix. */
  .exi__ship, .exi__impact, .exa__ship, .exu__ship, .exu__refuse {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  /* ── C ─────────────────────────────────────────────────────────────── */
  .exc__hold { fill: var(--color-navy); }
  .exc__lock { fill: none; stroke: var(--color-surface); stroke-width: 2; }
  .exc__lock-stem { stroke: var(--color-surface); stroke-width: 2; }
  .exc__boat path { fill: var(--color-navy); }
  .exc__boat line { stroke: var(--color-navy); stroke-width: 1.5; }
  .exc__line { stroke: var(--color-primary); stroke-width: 1; stroke-dasharray: 3 5; opacity: 0.45; }
  .exc__boom {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 1.5;
    stroke-dasharray: 7 6;
    opacity: 0.45;
    transform-origin: 200px 152px;
  }

  .ex__panel--active .exc__boom { animation: exc-boom 11s var(--ease-standard) infinite; }
  .ex__panel--active .exc__boat--r4 { animation: exc-turn-4 11s var(--ease-standard) infinite; }
  .ex__panel--active .exc__boat--r3 { animation: exc-turn-3 11s var(--ease-standard) infinite; }
  .ex__panel--active .exc__boat--r2 { animation: exc-turn-2 11s var(--ease-standard) infinite; }
  .ex__panel--active .exc__boat--r1 { animation: exc-admit 11s var(--ease-standard) infinite; }
  .ex__panel--active .exc__line--r4 { animation: exc-cut-4 11s var(--ease-standard) infinite; }
  .ex__panel--active .exc__line--r3 { animation: exc-cut-3 11s var(--ease-standard) infinite; }
  .ex__panel--active .exc__line--r2 { animation: exc-cut-2 11s var(--ease-standard) infinite; }
  .ex__panel--active .ex__cap--c0 { animation: exc-cap-0 11s var(--ease-standard) infinite; }
  .ex__panel--active .ex__cap--c3 { animation: exc-cap-3 11s var(--ease-standard) infinite; }

  /* The boom sweeps in past each ring in turn, then holds before reopening */
  @keyframes exc-boom {
    0%,  10%  { transform: scale(1);    opacity: 0.45; }
    30%       { transform: scale(0.78); opacity: 0.6; }
    48%       { transform: scale(0.56); opacity: 0.75; }
    66%, 88%  { transform: scale(0.52); opacity: 0.9; }
    97%, 100% { transform: scale(1);    opacity: 0.45; }
  }

  /* Refused boats drift outward along their own bearing as the boom reaches them */
  @keyframes exc-turn-4 {
    0%,  18%  { transform: translate(0, 0); opacity: 1; }
    32%, 88%  { transform: translate(var(--turn-x), var(--turn-y)); opacity: 0.16; }
    97%, 100% { transform: translate(0, 0); opacity: 1; }
  }
  @keyframes exc-turn-3 {
    0%,  36%  { transform: translate(0, 0); opacity: 1; }
    50%, 88%  { transform: translate(var(--turn-x), var(--turn-y)); opacity: 0.16; }
    97%, 100% { transform: translate(0, 0); opacity: 1; }
  }
  @keyframes exc-turn-2 {
    0%,  54%  { transform: translate(0, 0); opacity: 1; }
    68%, 88%  { transform: translate(var(--turn-x), var(--turn-y)); opacity: 0.16; }
    97%, 100% { transform: translate(0, 0); opacity: 1; }
  }
  /* The named boat is admitted: it comes inside the boom as the boom closes */
  @keyframes exc-admit {
    0%,  18%  { transform: translate(0, 0); }
    66%, 88%  { transform: translate(0, 72px); }
    97%, 100% { transform: translate(0, 0); }
  }
  @keyframes exc-cut-4 { 0%, 18% { opacity: 0.45; } 30%, 90% { opacity: 0; } 97%, 100% { opacity: 0.45; } }
  @keyframes exc-cut-3 { 0%, 36% { opacity: 0.45; } 48%, 90% { opacity: 0; } 97%, 100% { opacity: 0.45; } }
  @keyframes exc-cut-2 { 0%, 54% { opacity: 0.45; } 66%, 90% { opacity: 0; } 97%, 100% { opacity: 0.45; } }
  @keyframes exc-cap-0 { 0%, 12% { opacity: 1; } 22%, 100% { opacity: 0; } }
  @keyframes exc-cap-3 { 0%, 60% { opacity: 0; } 70%, 88% { opacity: 1; } 95%, 100% { opacity: 0; } }

  /* ── I ─────────────────────────────────────────────────────────────── */
  .exi__chart rect { fill: var(--color-surface-container-low); stroke: var(--color-divider-strong); stroke-width: 1.5; }
  .exi__chart-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; fill: var(--color-meta-label); }
  .exi__reading { font-family: var(--font-mono); font-size: 26px; font-weight: var(--weight-bold); fill: var(--color-primary); }
  .exi__unit { font-family: var(--font-mono); font-size: 10px; fill: var(--color-meta-label); }
  .exi__strike { stroke: var(--color-primary); stroke-width: 2.5; stroke-dasharray: 40; stroke-dashoffset: 40; }
  .exi__sea { fill: none; stroke: var(--color-primary); stroke-width: 1.5; opacity: 0.65; }
  .exi__bed { fill: var(--color-navy); opacity: 0.13; }
  .exi__truth { opacity: 0; }
  .exi__truth line { stroke: var(--color-primary); stroke-width: 2; }
  .exi__truth path { fill: var(--color-primary); }
  .exi__truth text { font-family: var(--font-mono); font-size: 20px; font-weight: var(--weight-bold); fill: var(--color-primary); }
  .exi__ship path:first-child { fill: var(--color-navy); }
  .exi__ship line { stroke: var(--color-navy); stroke-width: 2; }
  .exi__ship path:last-child { fill: var(--color-primary); }
  .exi__impact { opacity: 0; }
  .exi__impact line { stroke: var(--color-primary); stroke-width: 3; }

  .ex__panel--active .exi__ship   { animation: exi-sail 11s var(--ease-standard) infinite; }
  .ex__panel--active .exi__impact { animation: exi-hit 11s var(--ease-standard) infinite; }
  .ex__panel--active .exi__truth  { animation: exi-truth 11s var(--ease-standard) infinite; }
  .ex__panel--active .exi__strike { animation: exi-strike 11s var(--ease-standard) infinite; }
  .ex__panel--active .ex__cap--i0 { animation: exi-cap-0 11s var(--ease-standard) infinite; }
  .ex__panel--active .ex__cap--i1 { animation: exi-cap-1 11s var(--ease-standard) infinite; }

  /* Sails in from the left, grounds on the rock, then fades before resetting */
  @keyframes exi-sail {
    0%        { transform: translate(30px, 116px) rotate(0deg); opacity: 0; }
    8%        { transform: translate(46px, 116px) rotate(0deg); opacity: 1; }
    52%       { transform: translate(268px, 116px) rotate(0deg); opacity: 1; }
    62%       { transform: translate(288px, 112px) rotate(-13deg); opacity: 1; }
