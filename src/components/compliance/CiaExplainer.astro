---
import { EXPLAINER_STORIES } from '../../data/cia-explainer';
import ExplainerPanel from './ExplainerPanel.astro';
import ConfidentialityScene from './scenes/ConfidentialityScene.astro';
import IntegrityScene from './scenes/IntegrityScene.astro';
import AvailabilityScene from './scenes/AvailabilityScene.astro';
import ServiceLevelScene from './scenes/ServiceLevelScene.astro';
const scenes = [ConfidentialityScene, IntegrityScene, AvailabilityScene, ServiceLevelScene];
---
<div class="ex" data-explainer>
  <div class="ex__head">
    <h3 class="ex__title">Before you choose a cloud, know what you are protecting.</h3>
    <p class="ex__lede">A leak, a wrong record, an outage: <strong>CIA</strong> classifies their impact. For Slovak ISVS, the assessment then determines <strong>U, the required cloud service level.</strong></p>
  </div>
  <div class="ex__tabs" role="tablist" aria-label="Understand classification" data-needs-js hidden>
    {EXPLAINER_STORIES.map((story, index) => (
      <button type="button" role="tab" class="ex__tab" id={`ex-tab-${story.key}`} aria-controls={`ex-panel-${story.key}`} aria-selected={index === 0} tabindex={index === 0 ? 0 : -1} data-tab={story.key}>
        <span class="ex__tab-letter">{story.letter}</span>
        <span class="ex__tab-content"><span class="ex__tab-name">{story.name}</span><span class="ex__tab-sk">{story.sk}</span></span>
        <span class="ex__tab-index" aria-hidden="true">0{index + 1}</span>
      </button>
    ))}
  </div>
  {EXPLAINER_STORIES.map((story, index) => {
    const Scene = scenes[index];
    return <ExplainerPanel story={story} index={index}><Scene /></ExplainerPanel>;
  })}
</div>
<script>
  import { initializeExplainers } from '../../scripts/explainer';
  initializeExplainers();
  document.addEventListener('astro:page-load', () => initializeExplainers());
</script>
<style>

  .ex__head { max-width: var(--container-content); margin-bottom: var(--space-5); }
  .ex__title { font-family: var(--font-display); font-size: clamp(var(--text-title-lg), 3vw, var(--text-headline-md)); font-weight: var(--weight-semibold); letter-spacing: var(--tracking-tight); line-height: var(--leading-snug); color: var(--color-on-surface); text-wrap: balance; }
  .ex__lede { font-size: var(--text-body-md); line-height: var(--leading-relaxed); color: var(--color-on-surface-muted); margin-top: var(--space-3); max-width: 82ch; }
  .ex__lede strong { font-weight: var(--weight-medium); color: var(--color-on-surface); }
  .ex__tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); }
  .ex__tabs[hidden] { display: none; }
  .ex__tab { position: relative; display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--color-surface-container-low); border: 0; text-align: left; cursor: pointer; color: var(--color-on-surface); transition: background var(--duration-fast) var(--ease-standard); }
  .ex__tab:hover { background: var(--color-primary-tint); }
  .ex__tab[aria-selected="true"] { background: var(--color-navy); color: var(--color-on-primary); }
  .ex__tab-letter { font: var(--weight-medium) var(--text-title-lg) var(--font-mono); }
  .ex__tab-content { display: flex; flex-direction: column; gap: var(--space-1); min-width: 0; }
  .ex__tab-name { font: var(--weight-semibold) var(--text-label-md) var(--font-body); }
  .ex__tab-sk { font: var(--text-label-sm) var(--font-body); opacity: .8; }
  .ex__tab-index { display: none; margin-left: auto; font: var(--text-label-sm) var(--font-mono); opacity: .6; }
  .ex:not([data-ready]) :global(.scene *) { animation-play-state: paused; }
  @media (min-width: 768px) { .ex__tabs { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (min-width: 1280px) { .ex__tab-index { display: inline; } }
</style>
