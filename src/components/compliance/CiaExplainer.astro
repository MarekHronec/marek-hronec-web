---
/*
 * What C, I, A and U mean — four diagrams, one per concept.
 *
 * Each panel animates the idea rather than labelling it:
 *   C — a harbour boom closing until only one boat can reach the hold
 *   I — the chart still reads 12 fathoms; the rock is at 3. The instrument is
 *       fine, the recorded value is not, and the ship grounds on the difference
 *   A — a lighthouse beam sweeping, then going dark, leaving the ship unguided
 *   U — the result: C, I and A decide which berths may accept the ship. Higher
 *       classification does not burden the asset, it narrows where it may go
 *
 * Inline SVG with CSS keyframes. No library, no raster, scales to any width,
 * themes through currentColor. A JS animation runtime would cost ~30kB on a
 * site whose default is zero client-side JS. Only the visible panel animates,
 * so switching tabs restarts its sequence and nothing runs off-screen.
 */

const TABS = [
  { key: 'c', letter: 'C', name: 'Confidentiality', sk: 'Dôvernosť' },
  { key: 'i', letter: 'I', name: 'Integrity', sk: 'Integrita' },
  { key: 'a', letter: 'A', name: 'Availability', sk: 'Dostupnosť' },
  { key: 'u', letter: 'U', name: 'Service level', sk: 'Úroveň služby' },
];

/* Seven boats on an arc around the hold; tier decides when each is turned away. */
const BOATS = [
  { x: 112, y: 124, tier: 4 },
  { x: 124, y: 80,  tier: 3 },
  { x: 156, y: 48,  tier: 2 },
  { x: 200, y: 36,  tier: 1 },
  { x: 244, y: 48,  tier: 2 },
  { x: 276, y: 80,  tier: 3 },
  { x: 288, y: 124, tier: 4 },
];
---

<div class="ex">
  <div class="ex__head">
    <h3 class="ex__title">Reading the result: C, I, A and U</h3>
    <p class="ex__lede">
      Three questions about an asset, and one answer. Pick a letter to see what it means.
    </p>
  </div>

  <div class="ex__tabs" role="tablist" aria-label="Classification parameters">
    {TABS.map((t, i) => (
      <button
        type="button"
        role="tab"
        class:list={['ex__tab', { 'ex__tab--active': i === 0 }]}
        id={`ex-tab-${t.key}`}
        aria-controls={`ex-panel-${t.key}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        data-tab={t.key}
      >
        <span class="ex__tab-letter">{t.letter}</span>
        <span class="ex__tab-name">{t.name}</span>
        <span class="ex__tab-sk">{t.sk}</span>
      </button>
    ))}
  </div>

  <div class="ex__stage">

    <!-- ── C ─────────────────────────────────────────────────────────── -->
    <section class="ex__panel ex__panel--active" id="ex-panel-c" role="tabpanel" aria-labelledby="ex-tab-c" data-panel="c">
      <svg class="ex__svg" viewBox="0 0 400 240" role="img" aria-label="A harbour boom closing until only one boat can reach the hold">
        <g class="exc">
          <!-- approach lines -->
          {BOATS.map((b) => (
            <line class={`exc__line exc__line--t${b.tier}`} x1={b.x} y1={b.y} x2="200" y2="124" />
          ))}
          <!-- closing boom -->
          <circle class="exc__boom" cx="200" cy="124" r="100" />
          <!-- boats -->
          {BOATS.map((b) => (
            <g class={`exc__boat exc__boat--t${b.tier}`} transform={`translate(${b.x} ${b.y})`}>
              <path d="M-9 3 H9 L6 9 H-6 Z" />
              <line x1="0" y1="3" x2="0" y2="-7" />
            </g>
          ))}
          <!-- the hold -->
          <rect class="exc__hold" x="180" y="106" width="40" height="36" />
          <circle class="exc__lock" cx="200" cy="122" r="4" />
          <line class="exc__lock-stem" x1="200" y1="124" x2="200" y2="133" />
        </g>
        <text class="ex__cap ex__cap--open" x="200" y="212">C0 — anyone may see it</text>
        <text class="ex__cap ex__cap--shut" x="200" y="212">C3 — named individuals only</text>
      </svg>
      <div class="ex__copy">
        <h4>Who is allowed to see it</h4>
        <p>
          Confidentiality asks how damaging a leak would be, which in practice means
          how far the boom is closed. Public data lets everyone alongside. Strictly
          protected data admits named individuals and nobody else.
        </p>
      </div>
    </section>

    <!-- ── I ─────────────────────────────────────────────────────────── -->
    <section class="ex__panel" id="ex-panel-i" role="tabpanel" aria-labelledby="ex-tab-i" data-panel="i" hidden>
      <svg class="ex__svg" viewBox="0 0 400 240" role="img" aria-label="A chart records twelve fathoms where the seabed is actually three, and the ship grounds on the difference">
        <!-- the recorded value -->
        <g class="exi__chart">
          <rect x="24" y="24" width="104" height="62" />
          <text class="exi__chart-label" x="36" y="44">SOUNDING</text>
          <text class="exi__reading" x="36" y="74">12</text>
          <text class="exi__unit" x="74" y="74">fathoms</text>
        </g>
        <line class="exi__leader" x1="128" y1="60" x2="286" y2="112" />

        <!-- sea, seabed and the rock the chart does not know about -->
        <path class="exi__sea" d="M16 112 q 24 -6 48 0 t 48 0 t 48 0 t 48 0 t 48 0 t 48 0 t 48 0 t 48 0" />
        <path class="exi__bed" d="M16 208 H236 C 268 208, 276 130, 300 130 C 324 130, 332 208, 384 208 V240 H16 Z" />
        <text class="exi__truth" x="300" y="152">3</text>

        <!-- depth the chart promises, drawn against the real bed -->
        <g class="exi__gauge">
          <line x1="300" y1="116" x2="300" y2="126" />
          <path d="M300 126 l-4 -6 h8 z" />
        </g>

        <g class="exi__ship">
          <path d="M-16 0 H16 L11 11 H-11 Z" />
          <line x1="0" y1="0" x2="0" y2="-18" />
          <path d="M0 -17 L13 -10 L0 -3 Z" />
        </g>
        <g class="exi__impact">
          <line x1="-10" y1="-10" x2="10" y2="10" />
          <line x1="10" y1="-10" x2="-10" y2="10" />
        </g>

        <text class="ex__cap ex__cap--sail" x="200" y="230">The chart reads 12. Nothing looks wrong.</text>
        <text class="ex__cap ex__cap--ground" x="200" y="230">The rock is at 3. The chart was never corrected.</text>
      </svg>
      <div class="ex__copy">
        <h4>Whether the data can be trusted</h4>
        <p>
          Integrity is not about outages. The chart is legible, the system is up, and
          the sounding it records is simply wrong — so the ship sails a route that
          looks safe and grounds anyway. High integrity means an error in the data
          would immediately threaten the service that relies on it.
        </p>
      </div>
    </section>

    <!-- ── A ─────────────────────────────────────────────────────────── -->
    <section class="ex__panel" id="ex-panel-a" role="tabpanel" aria-labelledby="ex-tab-a" data-panel="a" hidden>
      <svg class="ex__svg" viewBox="0 0 400 240" role="img" aria-label="A lighthouse beam sweeping across the water, then going dark and leaving a ship without guidance">
        <!-- Beam rotates about the lamp itself, so it always emanates from it -->
        <g class="exa__beam">
          <path d="M100 74 L370 34 L370 118 Z" />
        </g>
        <!-- lighthouse -->
        <g class="exa__tower">
          <path class="exa__rock" d="M58 194 q 42 -26 84 0 z" />
          <path d="M86 194 L90 92 H110 L114 194 Z" />
          <path class="exa__gallery" d="M84 92 H116" />
          <rect class="exa__lamp" x="90" y="64" width="20" height="28" />
          <path d="M86 64 L100 48 L114 64 Z" />
        </g>
        <g class="exa__glow"><circle cx="100" cy="74" r="16" /></g>
        <circle class="exa__light" cx="100" cy="74" r="6" />

        <path class="exa__sea" d="M0 196 q 25 -6 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0" />
        <g class="exa__ship">
          <path d="M-15 0 H15 L11 11 H-11 Z" />
          <line x1="0" y1="0" x2="0" y2="-18" />
          <path d="M0 -17 L12 -10 L0 -3 Z" />
        </g>

        <text class="ex__cap ex__cap--lit" x="200" y="230">A1 — the light holds, or something else guides the ship</text>
        <text class="ex__cap ex__cap--dark" x="200" y="230">A3 — the light is out and nothing replaces it</text>
      </svg>
      <div class="ex__copy">
        <h4>Whether it is there when needed</h4>
        <p>
          Availability asks what an outage costs. If people can still reach the service
          another way, the light going out is survivable. If nothing replaces it, the
          asset is critical and an outage stops the essential service outright.
        </p>
      </div>
    </section>

    <!-- ── U ─────────────────────────────────────────────────────────── -->
    <section class="ex__panel" id="ex-panel-u" role="tabpanel" aria-labelledby="ex-tab-u" data-panel="u" hidden>
      <svg class="ex__svg" viewBox="0 0 400 240" role="img" aria-label="A ship carrying a classification is turned away from the two least protected berths and accepted at the third">
        <path class="exu__sea" d="M0 104 q 25 -5 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0 t 50 0" />

        <!-- Four berths, each better protected than the last -->
        {[
          { x: 58,  u: 1, wall: false, gate: false, tower: false },
          { x: 148, u: 2, wall: true,  gate: false, tower: false },
          { x: 238, u: 3, wall: true,  gate: true,  tower: false },
          { x: 328, u: 4, wall: true,  gate: true,  tower: true  },
        ].map((b) => (
          <g class={`exu__berth exu__berth--${b.u}`} transform={`translate(${b.x} 0)`}>
            <rect class="exu__slot" x="-34" y="92" width="68" height="76" />
            <line class="exu__quay" x1="-34" y1="168" x2="34" y2="168" />
            {b.wall && <path class="exu__wall" d="M-34 168 V134 M34 168 V134" />}
            {b.gate && <path class="exu__gate" d="M-34 134 H-18 M18 134 H34" />}
            {b.tower && <path class="exu__tower" d="M-7 134 h14 v-20 h-14 z M0 114 v-9" />}
            <text class="exu__label" x="0" y="188">U{b.u}</text>
          </g>
        ))}

        <!-- Refused at the berths that cannot take this classification -->
        {[58, 148].map((x, i) => (
          <g class={`exu__refuse exu__refuse--${i}`} transform={`translate(${x} 118)`}>
            <line x1="-13" y1="-13" x2="13" y2="13" />
            <line x1="13" y1="-13" x2="-13" y2="13" />
          </g>
        ))}

        <!-- The ship, carrying its classification -->
        <g class="exu__ship">
          <line class="exu__mast" x1="0" y1="-28" x2="0" y2="-56" />
          <path d="M-24 -28 H24 L18 -8 H-18 Z" />
          <!-- drawn last so the mast does not run through the classification -->
          <g class="exu__badge">
            <rect x="-32" y="-52" width="64" height="22" />
            <text x="0" y="-37">C2 I2 A2</text>
          </g>
        </g>

        <text class="ex__cap ex__cap--refused" x="200" y="228">U1 and U2 are not assured enough to take it</text>
        <text class="ex__cap ex__cap--berthed" x="200" y="228">U3 is the lowest berth allowed to accept it</text>
      </svg>
      <div class="ex__copy">
        <h4>Which environments may host it</h4>
        <p>
          U is the only value you do not choose. C, I and A together decide how well
          protected a berth has to be before it is allowed to take the ship — and the
          less assured berths are simply closed to it. The result is a floor, not a
          burden: U1 to U4 is the minimum level a Government Cloud service must hold
          to host the asset at all.
        </p>
      </div>
    </section>
  </div>
</div>

<script>
  // Scoped per instance rather than document-wide, so a second explainer on
  // a page cannot cross-wire this one's panel state.
  document.querySelectorAll<HTMLElement>('.ex').forEach(setup);

  function setup(root: HTMLElement) {
  const tabs = root.querySelectorAll<HTMLButtonElement>('.ex__tab');
  const panels = root.querySelectorAll<HTMLElement>('.ex__panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const key = tab.dataset.tab;
      tabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle('ex__tab--active', on);
        t.setAttribute('aria-selected', String(on));
      });
      panels.forEach((p) => {
        const on = p.dataset.panel === key;
        p.hidden = !on;
        // Toggling the class restarts the panel's keyframes from the top.
        p.classList.remove('ex__panel--active');
        if (on) void p.offsetWidth;
        p.classList.toggle('ex__panel--active', on);
      });
    });
  });
  }
</script>

<style>
  .ex {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-block: var(--space-6);
  }

  .ex__title {
    font-family: var(--font-display);
    font-size: var(--text-title-lg);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-on-surface);
  }

  .ex__lede {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-on-surface-muted);
    margin-top: var(--space-2);
    max-width: 68ch;
  }

  /* ── Tabs ──────────────────────────────────────────────────────────── */
  .ex__tabs {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-2);
  }

  @media (min-width: 768px) {
    .ex__tabs { grid-template-columns: repeat(4, 1fr); }
  }

  .ex__tab {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: var(--space-3) var(--space-4);
    background: none;
    border: 1px solid var(--color-divider);
    cursor: pointer;
    text-align: left;
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .ex__tab:hover { background-color: var(--color-surface-container-low); }

  .ex__tab--active {
    border-color: var(--color-primary);
    background-color: var(--color-primary-tint);
  }

  .ex__tab-letter {
    font-family: var(--font-mono);
    font-size: var(--text-title-md);
    font-weight: var(--weight-bold);
    color: var(--color-primary);
  }

  .ex__tab-name {
    font-size: var(--text-body-md);
    font-weight: var(--weight-semibold);
    color: var(--color-on-surface);
  }

  .ex__tab-sk {
    font-size: var(--text-label-md);
    font-style: italic;
    color: var(--color-on-surface-muted);
  }

  /* ── Stage ─────────────────────────────────────────────────────────── */
  .ex__panel {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    border: 1px solid var(--color-divider);
    padding: var(--space-4);
  }

  /* display:grid above outranks the UA's [hidden]{display:none}, so say it here */
  .ex__panel[hidden] { display: none; }

  @media (min-width: 1024px) {
    .ex__panel {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
      column-gap: var(--space-7);
    }
  }

  .ex__svg { width: 100%; height: auto; display: block; }

  .ex__copy h4 {
    font-family: var(--font-display);
    font-size: var(--text-title-md);
    font-weight: var(--weight-semibold);
    color: var(--color-on-surface);
    margin-bottom: var(--space-3);
  }

  .ex__copy p {
    font-size: var(--text-body-md);
    line-height: var(--leading-relaxed);
    color: var(--color-on-surface-muted);
  }

  /* ── Shared SVG vocabulary ─────────────────────────────────────────── */
  .ex__cap {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    fill: var(--color-meta-label);
    text-anchor: middle;
  }

  .ex__cap--open, .ex__cap--shut,
  .ex__cap--lit, .ex__cap--dark,
  .ex__cap--sail, .ex__cap--ground,
  .ex__cap--refused, .ex__cap--berthed { opacity: 0; }

  /* ── C: the closing boom ───────────────────────────────────────────── */
  .exc__hold { fill: var(--color-navy); }
  .exc__lock { fill: none; stroke: var(--color-surface); stroke-width: 2; }
  .exc__lock-stem { stroke: var(--color-surface); stroke-width: 2; }
  .exc__boat path { fill: var(--color-navy); }
  .exc__boat line { stroke: var(--color-navy); stroke-width: 1.5; }
  .exc__line { stroke: var(--color-primary); stroke-width: 1; stroke-dasharray: 3 4; opacity: 0.5; }
  .exc__boom {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 1.5;
    stroke-dasharray: 6 6;
    opacity: 0.5;
    /* scale about the hold, not the SVG origin */
    transform-origin: 200px 124px;
  }

  .ex__panel--active .exc__boom { animation: exc-boom 9s var(--ease-standard) infinite; }
  .ex__panel--active .exc__boat--t4,
  .ex__panel--active .exc__line--t4 { animation: exc-t4 9s var(--ease-standard) infinite; }
  .ex__panel--active .exc__boat--t3,
  .ex__panel--active .exc__line--t3 { animation: exc-t3 9s var(--ease-standard) infinite; }
  .ex__panel--active .exc__boat--t2,
  .ex__panel--active .exc__line--t2 { animation: exc-t2 9s var(--ease-standard) infinite; }
  .ex__panel--active .ex__cap--open { animation: exc-open 9s var(--ease-standard) infinite; }
  .ex__panel--active .ex__cap--shut { animation: exc-shut 9s var(--ease-standard) infinite; }

  @keyframes exc-boom {
    0%, 12%   { transform: scale(1); opacity: 0.5; }
    62%, 84%  { transform: scale(0.32); opacity: 0.9; }
    96%, 100% { transform: scale(1); opacity: 0.5; }
  }
  @keyframes exc-t4 { 0%, 14% { opacity: 1; } 26%, 88% { opacity: 0.1; } 96%, 100% { opacity: 1; } }
  @keyframes exc-t3 { 0%, 30% { opacity: 1; } 42%, 88% { opacity: 0.1; } 96%, 100% { opacity: 1; } }
  @keyframes exc-t2 { 0%, 46% { opacity: 1; } 58%, 88% { opacity: 0.1; } 96%, 100% { opacity: 1; } }
  @keyframes exc-open { 0%, 14% { opacity: 1; } 24%, 100% { opacity: 0; } }
  @keyframes exc-shut { 0%, 56% { opacity: 0; } 66%, 88% { opacity: 1; } 96%, 100% { opacity: 0; } }

  /* ── I: the chart is wrong ─────────────────────────────────────────── */
  .exi__chart rect { fill: var(--color-surface-container-low); stroke: var(--color-divider-strong); stroke-width: 1.5; }
  .exi__chart-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.12em; fill: var(--color-meta-label); }
  .exi__reading { font-family: var(--font-mono); font-size: 26px; font-weight: 700; fill: var(--color-primary); }
  .exi__unit { font-family: var(--font-mono); font-size: 10px; fill: var(--color-meta-label); }
  .exi__leader { stroke: var(--color-divider-strong); stroke-width: 1; stroke-dasharray: 3 4; }
  .exi__sea { fill: none; stroke: var(--color-primary); stroke-width: 1.5; opacity: 0.7; }
  .exi__bed { fill: var(--color-navy); opacity: 0.14; }
  .exi__truth {
    font-family: var(--font-mono); font-size: 15px; font-weight: 700;
    fill: var(--color-navy); text-anchor: middle; opacity: 0;
  }
  .exi__gauge line { stroke: var(--color-navy); stroke-width: 1.5; }
  .exi__gauge path { fill: var(--color-navy); }
  .exi__gauge { opacity: 0; }
  /* Without these the default origin is 50% 50% of the *view box*, so a
     combined translate+rotate pivots about (200,120) and lands ~40 units off.
     Pinning the origin to the viewBox corner makes translate() absolute and
     rotates each group about its own local origin. */
  .exi__ship, .exi__impact, .exa__ship, .exu__ship {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  .exi__ship path:first-child { fill: var(--color-navy); }
  .exi__ship line { stroke: var(--color-navy); stroke-width: 2; }
  .exi__ship path:last-child { fill: var(--color-primary); }
  .exi__impact line { stroke: var(--color-primary); stroke-width: 2.5; }
  .exi__impact { opacity: 0; }

  .ex__panel--active .exi__ship    { animation: exi-sail 9s var(--ease-standard) infinite; }
  .ex__panel--active .exi__impact  { animation: exi-hit 9s var(--ease-standard) infinite; }
  .ex__panel--active .exi__truth,
  .ex__panel--active .exi__gauge   { animation: exi-reveal 9s var(--ease-standard) infinite; }
  .ex__panel--active .exi__reading { animation: exi-flicker 9s var(--ease-standard) infinite; }
  .ex__panel--active .ex__cap--sail   { animation: exi-cap-a 9s var(--ease-standard) infinite; }
  .ex__panel--active .ex__cap--ground { animation: exi-cap-b 9s var(--ease-standard) infinite; }

  @keyframes exi-sail {
    0%, 6%    { transform: translate(40px, 106px) rotate(0deg); }
    52%       { transform: translate(268px, 106px) rotate(0deg); }
    62%, 86%  { transform: translate(286px, 102px) rotate(-11deg); }
    96%, 100% { transform: translate(40px, 106px) rotate(0deg); }
  }
  @keyframes exi-hit    { 0%, 56% { opacity: 0; transform: translate(300px, 114px) scale(0.6); }
                          66%, 86% { opacity: 1; transform: translate(300px, 114px) scale(1); }
                          92%, 100% { opacity: 0; transform: translate(300px, 114px) scale(0.6); } }
  @keyframes exi-reveal { 0%, 54% { opacity: 0; } 66%, 88% { opacity: 1; } 95%, 100% { opacity: 0; } }
  @keyframes exi-flicker{ 0%, 54% { opacity: 1; } 62% { opacity: 0.35; } 70%, 100% { opacity: 1; } }
  @keyframes exi-cap-a  { 0%, 44% { opacity: 1; } 54%, 100% { opacity: 0; } }
  @keyframes exi-cap-b  { 0%, 58% { opacity: 0; } 68%, 88% { opacity: 1; } 95%, 100% { opacity: 0; } }

  /* ── A: the light going out ────────────────────────────────────────── */
  .exa__beam path { fill: var(--color-primary); opacity: 0.16; }
  /* Rotating about the lamp keeps the beam attached to its source */
  .exa__beam { transform-origin: 100px 74px; }
  .exa__glow circle { fill: var(--color-primary); opacity: 0.22; }
  .exa__glow { transform-origin: 100px 74px; }
  .exa__tower path { fill: var(--color-navy); }
  .exa__gallery { stroke: var(--color-navy); stroke-width: 3; }
  .exa__lamp { fill: var(--color-surface); stroke: var(--color-navy); stroke-width: 2.5; }
  .exa__rock { fill: var(--color-navy); opacity: 0.3; }
  .exa__light { fill: var(--color-primary); }
  .exa__sea { fill: none; stroke: var(--color-primary); stroke-width: 1.5; opacity: 0.6; }
  .exa__ship path:first-child { fill: var(--color-navy); }
  .exa__ship line { stroke: var(--color-navy); stroke-width: 2; }
