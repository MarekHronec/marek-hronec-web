---
import GuideChapter from '../components/shared/GuideChapter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideHero from '../components/shared/GuideHero.astro';
import CostReading from '../components/cost/CostReading.astro';
import CostPlanner from '../components/cost/CostPlanner.astro';
import CostExplainer from '../components/cost/CostExplainer.astro';
---
<BaseLayout title="Cost — Understand the Whole Architecture" description="Explore idle capacity, scaling, data transfer and operational effort before estimating cloud workload costs.">
<GuideHero title="Understand what" accent="the architecture will cost" description="A server price is a starting point. Follow the capacity you keep, the demand you serve, the data you move and the work your team still owns."  />
<GuideChapter id="workload" guide="cost" kind="calculator" title="Cost Planner" description="Five answers identify measurements and costs to include. This is a planning checklist, not a price quote." topics={["5 questions", "Live priorities", "Next steps"]} action="Start planning"><CostPlanner /></GuideChapter>
  <GuideChapter id="options" guide="cost" kind="learn" title="Four costs behind the server price" description="See how releasing capacity, scaling and moving data affect the bill." topics={["Capacity", "Demand", "Transfer", "Operations"]} action="Explore"><CostExplainer /></GuideChapter>
  <GuideChapter id="reading" guide="cost" kind="reading" title="Billing and operating costs" description="Selected articles and primary sources for the decisions that need a closer look." topics={["Practical articles", "Source documents"]} action="Browse notes"><CostReading /></GuideChapter>
</BaseLayout>
