---
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideHero from '../components/shared/GuideHero.astro';
import { GUIDES } from '../data/architecture-guides';
import { base } from '../utils/base';
---
<BaseLayout title="Architecture Guides" description="Interactive guides for platform choices, cloud compliance and recovery planning.">
  <GuideHero title="Make the next" accent="architecture decision" description="Use these guides to frame a workload decision, explore the trade-offs and identify what to verify. Each combines plain explanations, marine illustrations and an interactive tool." />
  <section class="guides container" aria-label="Choose an architecture guide">
    {GUIDES.map((g, i) => <article><span>0{i + 1}</span><h2><a href={base + g.href}>{g.title} &rarr;</a></h2><p>{g.description}</p></article>)}
    <p class="guides__note">Start wherever your uncertainty is greatest. Use the Knowledge Base for detailed implementation notes and Case Studies for examples of applied architecture.</p>
  </section>
</BaseLayout>
<style>
  .guides { padding-bottom: var(--space-12); display: grid; gap: var(--space-5); }
  article { padding: var(--space-6); background: var(--color-surface-container-low); }
  article > span { font: var(--text-label-md) var(--font-mono); color: var(--color-primary); }
  h2 { margin-block: var(--space-3); font-size: var(--text-title-lg); }
  a { color: var(--color-navy); } p { color: var(--color-on-surface-muted); line-height: var(--leading-relaxed); }
  .guides__note { grid-column: 1 / -1; max-width: 80ch; }
  @media (min-width: 1024px) { .guides { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
