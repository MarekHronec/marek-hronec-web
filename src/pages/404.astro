---
import BaseLayout from '../layouts/BaseLayout.astro';
import { base } from '../utils/base';
---

<BaseLayout title="404 — Terra Incognita" description="This node exists only in the future blueprints.">
  <section class="terra">
    <!-- Nautical chart SVG background -->
    <svg class="terra__chart" viewBox="0 0 1200 700" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
      <!-- Depth contour rings — isobaths, wider spacing = deeper water -->
      <!-- Shallow bank, upper-left -->
      <ellipse cx="210" cy="170" rx="120" ry="80" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.18"/>
      <ellipse cx="210" cy="170" rx="155" ry="108" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.13"/>
      <ellipse cx="210" cy="170" rx="192" ry="138" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.10"/>
      <ellipse cx="210" cy="170" rx="232" ry="170" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.08"/>
      <!-- Island landmass, upper-left (solid fill = land) -->
      <ellipse cx="210" cy="170" rx="82" ry="52" fill="currentColor" opacity="0.06"/>
      <ellipse cx="210" cy="170" rx="62" ry="38" fill="currentColor" opacity="0.05"/>

      <!-- Deep channel, centre -->
      <ellipse cx="620" cy="360" rx="280" ry="140" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.11"/>
      <ellipse cx="620" cy="360" rx="340" ry="178" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.09"/>
      <ellipse cx="620" cy="360" rx="400" ry="216" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.07"/>

      <!-- Atoll / shoal, lower-right -->
      <ellipse cx="980" cy="540" rx="110" ry="70" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.17"/>
      <ellipse cx="980" cy="540" rx="148" ry="96" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.13"/>
      <ellipse cx="980" cy="540" rx="188" ry="124" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.10"/>
      <ellipse cx="980" cy="540" rx="230" ry="154" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.08"/>
      <ellipse cx="980" cy="540" rx="72" ry="45" fill="currentColor" opacity="0.06"/>

      <!-- Rhumb lines radiating from compass rose at lower-left -->
      <!-- 16 rhumb lines at 22.5° increments -->
      <g transform="translate(140, 560)" stroke="currentColor" stroke-width="0.6" opacity="0.14">
        <line x1="0" y1="0" x2="1100" y2="-220"/>
        <line x1="0" y1="0" x2="900" y2="-620"/>
        <line x1="0" y1="0" x2="560" y2="-800"/>
        <line x1="0" y1="0" x2="180" y2="-700"/>
        <line x1="0" y1="0" x2="-60" y2="-560"/>
        <line x1="0" y1="0" x2="1100" y2="160"/>
        <line x1="0" y1="0" x2="1060" y2="400"/>
        <line x1="0" y1="0" x2="700" y2="600"/>
        <line x1="0" y1="0" x2="320" y2="600"/>
      </g>

      <!-- Secondary compass rose, upper-right -->
      <g transform="translate(1060, 120)" stroke="currentColor" stroke-width="0.5" opacity="0.11">
        <line x1="0" y1="0" x2="-1000" y2="400"/>
        <line x1="0" y1="0" x2="-860" y2="-80"/>
        <line x1="0" y1="0" x2="-600" y2="-260"/>
        <line x1="0" y1="0" x2="-240" y2="-300"/>
        <line x1="0" y1="0" x2="-900" y2="580"/>
        <line x1="0" y1="0" x2="-500" y2="560"/>
        <line x1="0" y1="0" x2="100" y2="560"/>
      </g>

      <!-- Latitude-style parallel lines (faint) -->
      <line x1="0" y1="116" x2="1200" y2="116" stroke="currentColor" stroke-width="0.5" opacity="0.09"/>
      <line x1="0" y1="232" x2="1200" y2="232" stroke="currentColor" stroke-width="0.5" opacity="0.07"/>
      <line x1="0" y1="348" x2="1200" y2="348" stroke="currentColor" stroke-width="0.5" opacity="0.07"/>
      <line x1="0" y1="464" x2="1200" y2="464" stroke="currentColor" stroke-width="0.5" opacity="0.07"/>
      <line x1="0" y1="580" x2="1200" y2="580" stroke="currentColor" stroke-width="0.5" opacity="0.09"/>

      <!-- Longitude-style meridian lines (faint) -->
      <line x1="200" y1="0" x2="200" y2="700" stroke="currentColor" stroke-width="0.5" opacity="0.07"/>
      <line x1="400" y1="0" x2="400" y2="700" stroke="currentColor" stroke-width="0.5" opacity="0.07"/>
      <line x1="600" y1="0" x2="600" y2="700" stroke="currentColor" stroke-width="0.5" opacity="0.07"/>
      <line x1="800" y1="0" x2="800" y2="700" stroke="currentColor" stroke-width="0.5" opacity="0.07"/>
      <line x1="1000" y1="0" x2="1000" y2="700" stroke="currentColor" stroke-width="0.5" opacity="0.07"/>

      <!-- Small reef/rock markers (nautical X marks) -->
      <g stroke="currentColor" stroke-width="1" opacity="0.2">
        <line x1="374" y1="288" x2="382" y2="296"/><line x1="382" y1="288" x2="374" y2="296"/>
        <line x1="748" y1="194" x2="756" y2="202"/><line x1="756" y1="194" x2="748" y2="202"/>
        <line x1="860" y1="440" x2="868" y2="448"/><line x1="868" y1="440" x2="860" y2="448"/>
        <line x1="480" y1="520" x2="488" y2="528"/><line x1="488" y1="520" x2="480" y2="528"/>
      </g>
    </svg>

    <div class="terra__content container">
      <p class="terra__label">
        <span aria-hidden="true"></span>ERROR 404<span aria-hidden="true"></span>
      </p>
      <h1 class="terra__heading">Terra Incognita</h1>
      <p class="terra__body">
        It seems your sensors have drifted into an unmapped frontier
        of our architecture. This node exists only in the future blueprint.
      </p>
      <svg class="terra__compass" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M49.956 10c-.591-.003-.916.4-1.007.872l-2.443 8.242a30.937 30.937 0 0 0-15.897 6.6c-2.538-1.378-5.075-2.763-7.615-4.133c-.47-.253-.882-.234-1.262.149c-.381.383-.273.947-.058 1.353l4.069 7.495a30.931 30.931 0 0 0-6.634 15.932c-2.774.823-5.552 1.639-8.323 2.467c-.51.153-.787.458-.786.998c.002.54.476.863.916.998l8.189 2.426a30.936 30.936 0 0 0 6.599 15.98c-1.385 2.552-2.778 5.104-4.156 7.658c-.253.47-.234.88.15 1.261c.382.38.946.274 1.352.06l7.537-4.091a30.933 30.933 0 0 0 15.922 6.622c.822 2.775 1.64 5.554 2.468 8.325c.153.51.458.787.998.786c.54-.002.863-.476.998-.916l2.426-8.189a30.89 30.89 0 0 0 16.006-6.632l7.568 4.11c.549.28.92.329 1.34-.087c.421-.416.366-.932.097-1.33l-4.12-7.593a30.962 30.962 0 0 0 6.591-15.958l8.233-2.44c.586-.19.883-.417.886-1.009c.003-.591-.4-.916-.872-1.007l-8.27-2.451a30.967 30.967 0 0 0-6.607-15.91l4.09-7.531c.279-.55.328-.92-.088-1.341a.957.957 0 0 0-.671-.305a1.15 1.15 0 0 0-.659.21l-7.546 4.097a30.883 30.883 0 0 0-15.978-6.62l-2.434-8.212c-.19-.586-.417-.883-1.009-.886zm-.001 4.176v31.04a4.783 4.783 0 0 0-2.306.619l-4.979-6.308l5.214-18.143l.7-2.441zM54.14 21.6a28.54 28.54 0 0 1 12.96 5.355l-9.797 5.318zm-8.377.025l-3.144 10.607c-3.241-1.762-6.484-3.517-9.726-5.278a28.553 28.553 0 0 1 12.87-5.329zM24.65 24.65l15.602 15.57l-.008.023c-1.987.589-3.972 1.18-5.96 1.768l-5.988-10.793l-1.223-2.205zm50.648.018l-3.343 3.344l-1.673 1.672L59.73 40.237l-.075-.022l-1.754-5.916l10.865-6.015l1.308-.722l.89-.494zm-2.278 8.188a28.554 28.554 0 0 1 5.355 12.907l-10.648-3.156zm-46.039.008l5.29 9.744c-3.554 1.05-7.104 2.108-10.657 3.16a28.538 28.538 0 0 1 5.367-12.904zm33.392 9.779l18.242 5.24l2.413.694l4.795 1.378h-31.04a4.783 4.783 0 0 0-.631-2.328zm-15.156 7.312l-.002.045c0 .798.2 1.583.581 2.284L39.5 57.241l-6.241-1.788l-11.88-3.4v-.002l-2.438-.698l-4.813-1.378zm33.184 4.184a28.538 28.538 0 0 1-5.348 12.95l-5.313-9.79zm-56.79.003l10.647 3.155c-1.775 3.265-3.542 6.532-5.316 9.797a28.549 28.549 0 0 1-5.331-12.952zm30.697.047l4.96 6.211l-1.803 6.296L52.05 78.62l-.698 2.439l-1.378 4.813l-.02-31.09c.842.002 1.716-.218 2.354-.593zm13.403 3.71l6.01 10.86l1.218 2.199l2.421 4.374l-3.374-3.375l-1.673-1.672l-10.607-10.607zm-25.475 1.832c.592 2 1.187 3.996 1.778 5.996l-10.786 5.984l-2.207 1.224l-4.405 2.445zm17.074 7.966l9.82 5.333a28.552 28.552 0 0 1-12.989 5.358zm-14.7.042c1.05 3.55 2.106 7.097 3.157 10.646a28.54 28.54 0 0 1-12.894-5.36z" fill="currentColor"/>
        <path d="M46 8V0h1.981l4.127 5.342V0H54v8h-2.043l-4.065-5.217V8z" fill="currentColor"/>
        <path d="M46 97.347l1.933-.147q.174.764.705 1.123q.536.359 1.443.359q.96 0 1.442-.317q.49-.321.49-.749q0-.274-.208-.464q-.201-.195-.711-.337q-.349-.095-1.59-.338q-1.598-.31-2.242-.764q-.906-.639-.906-1.556q0-.59.423-1.102q.43-.517 1.228-.786q.805-.269 1.94-.269q1.852 0 2.785.638q.94.638.986 1.703l-1.986.069q-.128-.596-.55-.854q-.417-.264-1.256-.264q-.866 0-1.356.28q-.315.179-.315.48q0 .274.295.469q.376.248 1.826.517q1.45.269 2.14.559q.699.284 1.088.785q.396.496.396 1.23q0 .664-.47 1.244t-1.329.865q-.859.279-2.14.279q-1.866 0-2.866-.675q-1-.68-1.195-1.978z" fill="currentColor"/>
        <path d="M92 54v-8h7.8v1.353h-5.676v1.774h5.28v1.348h-5.28v2.177H100V54z" fill="currentColor"/>
        <path d="M1.455 54L0 46h1.26l.919 5.495L3.293 46h1.464l1.068 5.588L6.761 46H8l-1.48 8H5.214L4 48.02L2.79 54z" fill="currentColor"/>
      </svg>
      <a class="terra__cta" href={`${base}/`}>Chart a New Path →</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Lock the 404 page to the viewport — no scroll */
  html:has(.terra),
  html:has(.terra) body {
    height: 100%;
    overflow: hidden;
  }
</style>

<style>
  .terra {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--color-primary);
    background:
      radial-gradient(ellipse 50% 60% at 50% 50%, rgba(252,249,248,0.82) 0%, rgba(252,249,248,0) 100%),
      radial-gradient(ellipse 55% 45% at 18% 28%, rgba(44,105,78,0.06) 0%, rgba(44,105,78,0) 70%),
      radial-gradient(ellipse 48% 42% at 80% 22%, rgba(44,105,78,0.05) 0%, rgba(44,105,78,0) 70%),
      radial-gradient(ellipse 58% 38% at 55% 86%, rgba(44,105,78,0.05) 0%, rgba(44,105,78,0) 70%),
      var(--color-surface);
  }

  .terra__chart {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .terra__content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .terra__label {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0;
  }

  .terra__label span {
    display: block;
    width: 52px;
    height: 2px;
    background: var(--color-primary);
    opacity: 0.35;
  }

  .terra__heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-on-surface);
    margin: 0;
  }

  .terra__body {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-on-surface-muted);
    max-width: 46ch;
    margin: 0;
  }

  .terra__compass {
    width: 5rem;
    height: 5rem;
    color: var(--color-primary);
    opacity: 0.75;
    margin-block: var(--space-2);
  }

  .terra__cta {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    background: var(--gradient-cta);
    color: var(--color-on-primary);
    font-weight: var(--weight-semibold);
    font-size: var(--text-body-md);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .terra__cta:hover { transform: translateY(-2px); }
</style>
