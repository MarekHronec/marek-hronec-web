---
import GuideChapter from '../components/shared/GuideChapter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideHero from '../components/shared/GuideHero.astro';
import ResilienceExplainer from '../components/resilience/ResilienceExplainer.astro';
import RecoveryPlanner from '../components/resilience/RecoveryPlanner.astro';
import RecoveryReading from '../components/resilience/RecoveryReading.astro';
---
<BaseLayout title="Resilience — Design for Failure" description="Understand RTO, RPO, backups, replication and failure boundaries. Prepare a recovery brief for your cloud workload.">
  <GuideHero title="Design for failure." accent="Prepare for recovery" description="An outage is a business interruption before it is an infrastructure problem. Decide how long the operation can stop, how much data could be lost, and which failures the recovery plan must survive." tool={{label:'Recovery planner',href:'#recovery-planner',title:'Prepare a recovery brief',description:'Set targets, surface conflicting requirements and decide what to test next.'}} reference={{href:'#options',title:'Understand the four concepts',description:'Explore time, data, recovery copies and failure boundaries through marine illustrations.'}} />
  <GuideChapter id="options" guide="resilience" kind="learn" title="What it takes to recover" description="Explore time, lost changes, recovery copies and the failures your plan must survive." topics={["RTO", "RPO", "Recovery copies", "Failure boundaries"]} action="Explore"><ResilienceExplainer /></GuideChapter>
<GuideChapter id="workload" guide="resilience" kind="calculator" title="Prepare a recovery brief" description="Five answers surface recovery priorities and conflicting requirements." topics={["5 questions", "Live priorities", "Next steps"]} action="Start planning"><RecoveryPlanner /></GuideChapter>
<GuideChapter id="reading" guide="resilience" kind="reading" title="Recovery patterns and evidence" description="Selected articles and primary sources for the decisions that need a closer look." topics={["Practical articles", "Source documents"]} action="Browse notes"><RecoveryReading /></GuideChapter>
</BaseLayout>
