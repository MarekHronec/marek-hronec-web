---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategorySidebar from '../../components/knowledge-base/CategorySidebar.astro';
import ArticleCard from '../../components/knowledge-base/ArticleCard.astro';
import KnowledgeCanvas from '../../components/knowledge-base/KnowledgeCanvas.astro';
import SortIcon from '../../components/icons/SortIcon.astro';
import KBSearch from '../../components/knowledge-base/KBSearch.astro';
import { getCollection } from 'astro:content';
import { kbReadTime } from '../../utils/readTime';
import { edges, validateEdges } from '../../data/knowledge-graph';
import type { CanvasNode } from '../../scripts/canvas';

const articles = await getCollection('knowledgeBase');

// ── Build-time graph validation ───────────────────────────────────────────
// Throws during `npm run build` if any edge references a slug that does not exist.
const allSlugs = new Set(articles.map(a => a.id));
validateEdges(allSlugs);

// ── Canvas node data — curated three-branch learning tree ─────────────────

const CANVAS_START_NODE = 'multicloud/how-to-learn-azure-and-oci-without-stale-lists';

const ARTICLE_BRANCH: Record<string, string> = {
  'multicloud/iaas-paas-saas-without-marketing-layer':                           'cloud-reality',
  'multicloud/shared-responsibility-for-people-who-stopped-believing-marketing': 'cloud-reality',
  'multicloud/regions-zones-availability-domains-where-your-data-lives':         'cloud-reality',
  'multicloud/service-availability-by-region-why-you-cannot-trust-the-map':      'cloud-reality',
  'multicloud/tenant-subscription-management-group-compartment':                 'governance',
  'multicloud/landing-zones-what-they-solve-and-the-honest-catch':               'governance',
  'multicloud/sandboxes-environments-you-will-probably-set-up-wrong':            'governance',
  'multicloud/naming-conventions-azure-oci':                                      'governance',
  'multicloud/tagging-metadata-earn-their-keep':                                  'governance',
  'security/policy-as-code-and-quotas-where-governance-stops-being-wiki':        'governance',
  'multicloud/documentation-ccoe-why-both-decay-faster-than-you-think':          'governance',
  'networking/address-plans-designing-ip-space-for-three-clouds':                'network',
  'networking/ipam-ip-address-management-before-you-wish-you-had-done-it':       'network',
  'networking/hub-and-spoke-virtual-wan-and-drg-three-topology-choices':         'network',
  'networking/hybrid-connectivity-expressroute-fastconnect-vpn-reality':         'network',
};

const CANVAS_ARTICLE_IDS = new Set([CANVAS_START_NODE, ...Object.keys(ARTICLE_BRANCH)]);

// Synthetic group-header nodes (not from the content collection)
const GROUP_NODES: CanvasNode[] = [
  { id: 'group:cloud-reality', label: 'Cloud Reality & Thinking',          category: '', level: 'beginner', excerpt: '', url: '', tags: [], nodeType: 'group', branch: 'cloud-reality' },
  { id: 'group:governance',    label: 'Platform Organisation & Governance', category: '', level: 'beginner', excerpt: '', url: '', tags: [], nodeType: 'group', branch: 'governance'    },
  { id: 'group:network',       label: 'Network Architecture',               category: '', level: 'beginner', excerpt: '', url: '', tags: [], nodeType: 'group', branch: 'network'       },
];

const BRANCH_RANK: Record<string, number> = { 'cloud-reality': 0, governance: 1, network: 2 };

const canvasNodes: CanvasNode[] = [
  ...GROUP_NODES,
  ...articles
    .filter(a => CANVAS_ARTICLE_IDS.has(a.id))
    .sort((a, b) => (BRANCH_RANK[ARTICLE_BRANCH[a.id] ?? ''] ?? -1) - (BRANCH_RANK[ARTICLE_BRANCH[b.id] ?? ''] ?? -1))
    .map(a => ({
      id:       a.id,
      label:    a.data.title,
      category: a.data.category,
      level:    a.data.level,
      excerpt:  a.data.excerpt,
      url:      `/knowledge-base/${a.id}`,
      tags:     a.data.tags,
      nodeType: 'article' as const,
      branch:   ARTICLE_BRANCH[a.id] ?? '',
    })),
];

/* Sort newest first (default) */
const sorted = articles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

/* ── Platform / topic derivation ─────────────────────────────────
   Platform: articles whose category is a cloud platform (azure, oci, gcp)
   Topics:   derived from category (for topic-category articles)
             + from tags (Networking, Identity, Security, FinOps, Landing Zones)
──────────────────────────────────────────────────────────────── */
const PLATFORM_CATS = new Set(['azure', 'oci', 'gcp', 'multicloud']);
const TOPIC_CATS = new Set(['networking', 'identity', 'security', 'finops', 'devops', 'bpm']);
const TAG_TO_TOPIC: Record<string, string> = {
  'Networking':    'networking',
  'Identity':      'identity',
  'Security':      'security',
  'FinOps':        'finops',
  'Landing Zones': 'landing-zones',
  'DevOps':        'devops',
  'BPM':           'bpm',
};

function getArticlePlatforms(article: typeof sorted[0]): string {
  return PLATFORM_CATS.has(article.data.category) ? article.data.category : '';
}

function getArticleTopics(article: typeof sorted[0]): string {
  const topics = new Set<string>();
  const cat = article.data.category;
  if (TOPIC_CATS.has(cat)) topics.add(cat);
  for (const tag of article.data.tags) {
    const mapped = TAG_TO_TOPIC[tag];
    if (mapped) topics.add(mapped);
  }
  return Array.from(topics).join(',');
}

const totalCount = sorted.length;
---

<BaseLayout
  title="Knowledge Base"
  description="Technical articles on cloud architecture, Azure, DevOps, and infrastructure patterns."
  ogImage="/images/og-image.webp"
>
  <!-- Runs synchronously before first paint — prevents canvas→list blink on page load / navigation -->
  <script is:inline>
    if (sessionStorage.getItem('kb-view') === 'map') {
      document.documentElement.classList.add('kb-canvas-init');
    }
  </script>

  <div class="kb-page" id="kb-page">

    <CategorySidebar />

    <div class="kb-content">
      <div class="kb-content__inner">

        <!-- Collapses as a unit when canvas view activates -->
        <div class="kb-preflight">
          <div class="kb-preflight__inner">

            <!-- Page header -->
            <header class="kb-header">
              <p class="kb-header__label">Knowledge Base</p>
              <h1 class="kb-header__title">Technical Notes<span class="kb-header__period">.</span></h1>
              <p class="kb-header__subtitle">
                In-depth architecture patterns, implementation guides, and
                operational constraints for cloud-native systems.
              </p>
            </header>

            <!-- Full-text search (Pagefind — index generated at build time) -->
            <KBSearch />

          </div>
        </div>

        <!-- Toolbar: article count + active filter chips + view toggle + sort -->
        <div class="kb-toolbar">
          <p class="kb-toolbar__count">
            <span id="kb-article-count">{totalCount}</span>
            <span id="kb-article-count-label">{totalCount === 1 ? 'article' : 'articles'}</span>
          </p>
          <div class="kb-toolbar__chips" id="kb-chips" hidden></div>

          <!-- View toggle — desktop only (hidden on mobile via CSS) -->
          <div class="kb-view-toggle" aria-label="View mode" role="group">
            <button id="kb-view-list" class="kb-view-toggle__btn kb-view-toggle__btn--active" aria-pressed="true">
              <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 2.5h12M1 7h12M1 11.5h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              List View
            </button>
            <button id="kb-view-map" class="kb-view-toggle__btn" aria-pressed="false">
              <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="4" r="2" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="3" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="13" cy="12" r="2" stroke="currentColor" stroke-width="1.5"/>
                <path d="M8 6v2M6.3 10.7L4.4 10M9.7 10.7l1.9-.7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              </svg>
              Canvas View
            </button>
          </div>

          <div class="kb-toolbar__sort">
            <SortIcon size={14} class="kb-toolbar__sort-icon" aria-hidden="true" />
            <div class="kb-sort-wrap">
              <label class="visually-hidden" for="kb-sort">Sort by</label>
              <select id="kb-sort" class="kb-sort">
                <option value="latest">Latest first</option>
                <option value="oldest">Oldest first</option>
                <option value="title">Title A–Z</option>
              </select>
              <svg class="kb-sort-chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                <path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </div>

        <!-- List view — hidden as a unit when map view is active -->
        <div id="kb-list-body">

          {sorted.length > 0 ? (
            <div class="kb-list" id="kb-grid">
              {sorted.map((article) => (
                <div
                  class="kb-card-wrapper"
                  data-platforms={getArticlePlatforms(article)}
                  data-topics={getArticleTopics(article)}
                  data-level={article.data.level}
                  data-date={article.data.date.toISOString()}
                  data-title={article.data.title}
                >
                  <ArticleCard
                    slug={article.id}
                    title={article.data.title}
                    excerpt={article.data.excerpt}
                    date={article.data.date}
                    readTime={kbReadTime(article.body ?? '', article.data.category, article.data.readTime)}
                    level={article.data.level}
                    tags={article.data.tags}
                  />
                </div>
              ))}
            </div>
          ) : (
            <p class="kb-empty">No articles published yet.</p>
          )}

          <p class="kb-empty kb-empty--filtered" id="kb-filter-empty" hidden>
            No articles match the selected filters.
          </p>

          <nav class="kb-pagination" id="kb-pagination" aria-label="Article pagination" hidden></nav>

        </div>

        <!-- Learning Map canvas — shown when user switches to map view, replaces list body -->
        <KnowledgeCanvas nodes={canvasNodes} edges={edges} />

      </div>
    </div>

  </div>
</BaseLayout>

<style>
  /* ── Two-column layout ──────────────────────────────────────────── */
  .kb-page {
    display: flex;
    align-items: stretch;
    flex: 1;
    min-height: 0;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
  }

  /* Hide filter panel on mobile */
  .kb-page :global(.kb-filter) {
    display: none;
  }

  @media (min-width: 768px) {
    .kb-page :global(.kb-filter) {
      display: block;
    }
  }

  /* ── Canvas mode — instant layout switch, no transitions ─────────────── */
  @media (min-width: 768px) {
    .kb-page--canvas :global(.kb-filter) {
      display: none;
    }
  }

  .kb-preflight__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .kb-page--canvas .kb-preflight {
    display: none;
  }

  .kb-page--canvas .kb-toolbar__count,
  .kb-page--canvas .kb-toolbar__chips,
  .kb-page--canvas .kb-toolbar__sort {
    display: none;
  }

  .kb-page--canvas .kb-toolbar {
    justify-content: flex-end;
    min-height: 0;
    padding: var(--space-3) var(--space-4);
  }

  .kb-page--canvas .kb-content {
    padding: 0;
  }

  .kb-page--canvas .kb-content__inner {
    gap: 0;
  }

  .kb-page--canvas :global(.kbc-wrapper) {
    height: calc(100vh - 8rem);
    border-radius: 0;
  }

  /* Content panel */
  .kb-content {
    flex: 1;
    min-width: 0;
    padding: var(--space-6) var(--space-5) calc(var(--space-10) + var(--nav-height));
  }

  @media (min-width: 768px) {
    .kb-content {
      padding: var(--space-8) var(--space-8) var(--space-10);
    }
  }

  @media (min-width: 1024px) {
    .kb-content {
      padding: var(--space-8) var(--space-10) var(--space-10);
    }
  }

  .kb-content__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* ── Page header ──────────────────────────────────────────────── */
  .kb-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding-top: var(--space-4);
  }

  .kb-header__label {
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .kb-header__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, var(--text-display-lg));
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-on-surface);
  }

  .kb-header__period {
    color: var(--color-meta-label);
  }

  .kb-header__subtitle {
    font-size: var(--text-body-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-on-surface-muted);
    max-width: 52ch;
  }

  /* ── Toolbar ──────────────────────────────────────────────────── */
  .kb-toolbar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    min-height: 2rem;
  }

  .kb-toolbar__count {
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-kb-text-muted);
    white-space: nowrap;
    display: flex;
    gap: 0.3em;
  }

  .kb-toolbar__chips {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .kb-toolbar__chips::-webkit-scrollbar {
    display: none;
  }

  /* ── View toggle (desktop only) ──────────────────────────────────── */
  .kb-view-toggle {
    display: none; /* hidden on mobile — canvas view not available */
    align-items: center;
    gap: 2px;
    margin-left: auto;
    flex-shrink: 0;
    background: var(--color-surface-container);
    border-radius: var(--radius-sm);
    padding: 2px;
  }

  @media (min-width: 768px) {
    .kb-view-toggle {
      display: flex;
    }
  }

  .kb-view-toggle__btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 28px;
    padding: 0 var(--space-3);
    border-radius: calc(var(--radius-sm) - 2px);
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.02em;
    color: var(--color-on-surface-muted);
    cursor: pointer;
    white-space: nowrap;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  .kb-view-toggle__btn:hover {
    color: var(--color-on-surface);
  }

  .kb-view-toggle__btn--active,
  .kb-view-toggle__btn--active:hover {
    background: var(--color-surface-container-lowest);
    color: var(--color-primary);
    box-shadow: var(--shadow-sm);
  }

  .kb-toolbar__sort {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .kb-toolbar__sort-icon {
    color: var(--color-kb-text-muted);
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .kb-toolbar__sort:hover .kb-toolbar__sort-icon {
    color: var(--color-primary);
  }

  /* Flex row: [select text] [chevron] — no overlap, no clipping */
  .kb-sort-wrap {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .kb-sort {
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    font-weight: var(--weight-semibold);
    letter-spacing: normal; /* letter-spacing on <select> clips last char in Chrome — keep normal */
    text-transform: uppercase;
    color: var(--color-on-surface);
    background: transparent;
    border: none;
    outline: none;
    padding: var(--space-1) 0;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .kb-sort:hover,
  .kb-sort:focus-visible {
    color: var(--color-primary);
  }

  .kb-sort:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .kb-sort-chevron {
    pointer-events: none;
    flex-shrink: 0;
    color: var(--color-kb-text-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .kb-sort:hover ~ .kb-sort-chevron {
    color: var(--color-primary);
  }

  /* ── Article list (single column) ────────────────────────────── */
  .kb-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .kb-card-wrapper {
    display: flex;
  }

  .kb-empty {
    color: var(--color-on-surface-muted);
    font-size: var(--text-body-lg);
    padding: var(--space-8) 0;
  }

  /* ── Chip styles (dynamically rendered by JS) ─────────────────── */
  :global(.kb-chip) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 3px var(--space-3);
    background: var(--color-level-advanced-bg);
    color: var(--color-level-advanced-text);
    border-radius: var(--radius-full);
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-standard);
    white-space: nowrap;
  }

  :global(.kb-chip:hover) {
    background: var(--color-primary-container);
  }

  :global(.kb-chip--clear) {
    background: var(--color-surface-container-high);
    color: var(--color-on-surface-muted);
  }

  :global(.kb-chip--clear:hover) {
    background: var(--color-surface-container-high);
    color: var(--color-on-surface);
  }

  /* visually-hidden utility for accessible labels */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Pagination ─────────────────────────────────────────────────
     All children are JS-created so they don't carry the Astro scoped
     data attribute — :global() is required for every rule here.
  ─────────────────────────────────────────────────────────────── */
  :global(.kb-pagination) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding-top: var(--space-8);
  }

  /* Prev / Next */
  :global(.kb-page-nav) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 2rem;
    padding: 0 var(--space-3);
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    color: var(--color-on-surface-muted);
    background: transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  :global(.kb-page-nav:hover:not(:disabled)) {
    color: var(--color-on-surface);
  }

  :global(.kb-page-nav:disabled) {
    opacity: 0.25;
    cursor: not-allowed;
    pointer-events: none;
  }

  :global(.kb-page-nav:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* Page number buttons container */
  :global(.kb-pagination__pages) {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  /* Individual page number */
  :global(.kb-page-num) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    padding: 0 var(--space-1);
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    font-weight: var(--weight-regular);
    color: var(--color-on-surface-muted);
    background: transparent;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard);
  }

  :global(.kb-page-num:hover) {
    color: var(--color-on-surface);
    background: var(--color-surface-container-low);
  }

  :global(.kb-page-num[aria-current="page"]) {
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
    background: var(--color-surface-container);
  }

  :global(.kb-page-num:focus-visible) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Ellipsis */
  :global(.kb-page-ellipsis) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    height: 2rem;
    font-size: var(--text-label-md);
    color: var(--color-on-surface-muted);
    opacity: 0.5;
    pointer-events: none;
    user-select: none;
  }

  /* Mobile compact: "2 / 5" */
  :global(.kb-pagination__compact) {
    font-family: var(--font-body);
    font-size: var(--text-label-md);
    color: var(--color-on-surface-muted);
    letter-spacing: 0.04em;
  }

  @media (min-width: 480px) {
    :global(.kb-pagination__compact) { display: none; }
  }

  @media (max-width: 479px) {
    :global(.kb-pagination__pages) { display: none; }
  }
</style>

<!-- Global rules that match the canvas-mode scoped rules above.
     Applied synchronously by the inline script (kb-canvas-init class on <html>)
     so the layout is correct before the first paint when restoring from session. -->
<style is:global>
  html.kb-canvas-init .kb-preflight         { display: none; }
  html.kb-canvas-init .kb-filter            { display: none; }
  html.kb-canvas-init .kb-toolbar__count,
  html.kb-canvas-init .kb-toolbar__chips,
  html.kb-canvas-init .kb-toolbar__sort     { display: none; }
  html.kb-canvas-init .kb-toolbar {
    justify-content: flex-end;
    min-height: 0;
    padding: var(--space-3) var(--space-4);
  }
  html.kb-canvas-init .kb-content           { padding: 0; }
  html.kb-canvas-init .kb-content__inner    { gap: 0; }
  html.kb-canvas-init .kbc-wrapper {
    height: calc(100vh - 8rem);
    border-radius: 0;
  }
</style>

<script>
  (function () {
    'use strict';

    /* ── Label maps ─────────────────────────────────────────────── */
    const LABELS: Record<string, Record<string, string>> = {
      platform: { azure: 'Azure', oci: 'OCI', gcp: 'GCP', multicloud: 'Multicloud' },
      topic: {
        networking: 'Networking', identity: 'Identity', security: 'Security',
        finops: 'FinOps', 'landing-zones': 'Landing Zones', devops: 'DevOps', bpm: 'BPM',
      },
      level: { beginner: 'Foundations', intermediate: 'Practitioner', advanced: 'Expert' },
    };

    /* URL param name per group */
    const URL_PARAMS: Record<string, string> = {
      platform: 'platforms',
      topic:    'topics',
      level:    'level',
    };

    /* ── Constants ──────────────────────────────────────────────── */
    const PAGE_SIZE = 15;

    /* ── State ──────────────────────────────────────────────────── */
    /* One Record of Sets keyed by group name. Every operation (toggle,
       clear, count, chips, URL) iterates this generically — adding a
       group requires one entry here, not changes across 12 functions. */
    const activeFilters: Record<string, Set<string>> = {
      platform: new Set<string>(),
      topic:    new Set<string>(),
      level:    new Set<string>(),
    };
    let activeSort = 'latest';
    let currentPage = 1;

    /* ── DOM refs ───────────────────────────────────────────────── */
    const grid          = document.getElementById('kb-grid');
    const countEl       = document.getElementById('kb-article-count');
    const countLabelEl  = document.getElementById('kb-article-count-label');
    const chipsEl       = document.getElementById('kb-chips') as HTMLElement | null;
    const allArticlesBtn  = document.getElementById('kb-all-articles');
    const allCountEl      = document.getElementById('kb-all-count');
    const mobileAllBtn    = document.getElementById('kb-mobile-all-articles');
    const mobileAllCountEl = document.getElementById('kb-mobile-all-count');
    const sortEl        = document.getElementById('kb-sort') as HTMLSelectElement | null;
    const emptyEl       = document.getElementById('kb-filter-empty');
    const mobileBadge   = document.getElementById('kb-mobile-badge');
    const paginationEl  = document.getElementById('kb-pagination') as HTMLElement | null;

    const wrappers = Array.from(document.querySelectorAll<HTMLElement>('[data-platforms]'));

    /* ── Article value accessors per group ──────────────────────── */
    const articleValues: Record<string, (w: HTMLElement) => string[]> = {
      platform: w => (w.dataset.platforms ?? '').split(',').filter(Boolean),
      topic:    w => (w.dataset.topics    ?? '').split(',').filter(Boolean),
      level:    w => (w.dataset.level ? [w.dataset.level] : []),
    };

    /* ── Init from URL ──────────────────────────────────────────── */
    const params = new URLSearchParams(window.location.search);
    Object.entries(URL_PARAMS).forEach(([group, param]) => {
      (params.get(param) ?? '').split(',').filter(Boolean).forEach(v => activeFilters[group].add(v));
    });
    activeSort = params.get('sort') ?? 'latest';
    if (sortEl) sortEl.value = activeSort;
    currentPage = parseInt(params.get('page') ?? '1', 10) || 1;

    /* ── Filter logic ───────────────────────────────────────────── */
    function matchesFilter(w: HTMLElement): boolean {
      return Object.entries(activeFilters).every(([g, active]) =>
        active.size === 0 || articleValues[g](w).some(v => active.has(v))
      );
    }

    /* Count articles matching all groups, treating `group` as if only `value` is selected */
    function countForBtn(group: string, value: string): number {
      return wrappers.filter(w =>
        Object.entries(activeFilters).every(([g, active]) =>
          g === group
            ? articleValues[g](w).includes(value)
            : active.size === 0 || articleValues[g](w).some(v => active.has(v))
        )
      ).length;
    }

    function sortFn(a: HTMLElement, b: HTMLElement): number {
      if (activeSort === 'oldest') return (a.dataset.date  ?? '').localeCompare(b.dataset.date  ?? '');
      if (activeSort === 'title')  return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
      return (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '');
    }

    /* ── Scroll helper ──────────────────────────────────────────── */
    function scrollToArticles(): void {
      document.querySelector<HTMLElement>('.kb-toolbar')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    /* ── Page range ─────────────────────────────────────────────── */
    function getPageRange(current: number, total: number): (number | '...')[] {
      if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
      const rangeSet = new Set([1, total]);
      for (let i = current - 1; i <= current + 1; i++) {
        if (i >= 1 && i <= total) rangeSet.add(i);
      }
      const sorted = Array.from(rangeSet).sort((a, b) => a - b);
      const result: (number | '...')[] = [];
      for (let i = 0; i < sorted.length; i++) {
        if (i > 0 && sorted[i] - sorted[i - 1] > 1) result.push('...');
        result.push(sorted[i]);
      }
      return result;
    }

    /* ── Render pagination ──────────────────────────────────────── */
    function renderPagination(totalPages: number, current: number): void {
      if (!paginationEl) return;
      if (totalPages <= 1) { paginationEl.hidden = true; paginationEl.innerHTML = ''; return; }

      paginationEl.hidden = false;
      paginationEl.innerHTML = '';

      const prevBtn = document.createElement('button');
      prevBtn.className = 'kb-page-nav';
      prevBtn.setAttribute('aria-label', 'Go to previous page');
      prevBtn.disabled = current === 1;
      prevBtn.innerHTML = `<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M8 2L4 6l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> Prev`;
      prevBtn.addEventListener('click', () => { currentPage = current - 1; apply(); scrollToArticles(); });
      paginationEl.appendChild(prevBtn);

      const compactSpan = document.createElement('span');
      compactSpan.className = 'kb-pagination__compact';
      compactSpan.setAttribute('aria-hidden', 'true');
      compactSpan.textContent = `${current} / ${totalPages}`;
      paginationEl.appendChild(compactSpan);

      const pagesDiv = document.createElement('div');
      pagesDiv.className = 'kb-pagination__pages';
      getPageRange(current, totalPages).forEach(item => {
        if (item === '...') {
          const el = document.createElement('span');
          el.className = 'kb-page-ellipsis';
          el.setAttribute('aria-hidden', 'true');
          el.textContent = '…';
          pagesDiv.appendChild(el);
        } else {
          const pageBtn = document.createElement('button');
          pageBtn.className = 'kb-page-num';
          pageBtn.setAttribute('aria-label', `Go to page ${item}`);
          if (item === current) pageBtn.setAttribute('aria-current', 'page');
          pageBtn.textContent = String(item);
          pageBtn.addEventListener('click', () => { currentPage = item as number; apply(); scrollToArticles(); });
          pagesDiv.appendChild(pageBtn);
        }
      });
      paginationEl.appendChild(pagesDiv);

      const nextBtn = document.createElement('button');
      nextBtn.className = 'kb-page-nav';
      nextBtn.setAttribute('aria-label', 'Go to next page');
      nextBtn.disabled = current === totalPages;
      nextBtn.innerHTML = `Next <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
      nextBtn.addEventListener('click', () => { currentPage = current + 1; apply(); scrollToArticles(); });
      paginationEl.appendChild(nextBtn);
    }

    /* ── Apply filter + sort ────────────────────────────────────── */
    function apply() {
      const visible: HTMLElement[] = [];
      const hidden:  HTMLElement[] = [];
      for (const w of wrappers) (matchesFilter(w) ? visible : hidden).push(w);

      visible.sort(sortFn);

      const totalPages = Math.max(1, Math.ceil(visible.length / PAGE_SIZE));
      if (currentPage > totalPages) currentPage = totalPages;
      const startIdx = (currentPage - 1) * PAGE_SIZE;
      const pageSlice = new Set(visible.slice(startIdx, startIdx + PAGE_SIZE));

      if (grid) [...visible, ...hidden].forEach(w => grid.appendChild(w));
      visible.forEach(w => { w.style.display = pageSlice.has(w) ? '' : 'none'; });
      hidden.forEach(w  => (w.style.display = 'none'));

      const n = visible.length;
      if (countEl) countEl.textContent = String(n);
      if (countLabelEl) countLabelEl.textContent = n === 1 ? 'article' : 'articles';

      document.querySelectorAll<HTMLElement>('[data-filter-group]').forEach(btn => {
        const group = btn.dataset.filterGroup ?? '';
        const value = btn.dataset.filterValue ?? '';
        btn.setAttribute('aria-pressed', (activeFilters[group]?.has(value) ?? false) ? 'true' : 'false');
        const countSpan = btn.querySelector('.kb-filter__count');
        if (countSpan) {
          const c = countForBtn(group, value);
          countSpan.textContent = c > 0 ? `[${c}]` : '';
        }
      });

      const totalActive = Object.values(activeFilters).reduce((n, s) => n + s.size, 0);
      if (mobileBadge) { mobileBadge.textContent = String(totalActive); mobileBadge.hidden = totalActive === 0; }

      const hasFilters = Object.values(activeFilters).some(s => s.size > 0);
      allArticlesBtn?.setAttribute('aria-pressed', hasFilters ? 'false' : 'true');
      mobileAllBtn?.setAttribute('aria-pressed', hasFilters ? 'false' : 'true');
      const totalLabel = `[${wrappers.length}]`;
      if (allCountEl) allCountEl.textContent = totalLabel;
      if (mobileAllCountEl) mobileAllCountEl.textContent = totalLabel;

      updateChips();
      renderPagination(totalPages, currentPage);
      updateURL();
      if (emptyEl) emptyEl.hidden = !(hasFilters && n === 0);
    }

    /* ── Chips ──────────────────────────────────────────────────── */
    function updateChips() {
      if (!chipsEl) return;
      chipsEl.innerHTML = '';
      const chips = Object.entries(activeFilters).flatMap(([group, active]) =>
        [...active].map(value => ({ group, value }))
      );

      if (chips.length > 0) {
        const clearAll = document.createElement('button');
        clearAll.className = 'kb-chip kb-chip--clear';
        clearAll.setAttribute('aria-label', 'Clear all filters');
        clearAll.innerHTML = `Clear filters <span aria-hidden="true">×</span>`;
        clearAll.addEventListener('click', () => {
          Object.values(activeFilters).forEach(s => s.clear());
          currentPage = 1;
          apply();
        });
        chipsEl.appendChild(clearAll);
      }

      chips.forEach(({ group, value }) => {
        const label = LABELS[group]?.[value] ?? value;
        const btn = document.createElement('button');
        btn.className = 'kb-chip';
        btn.setAttribute('aria-label', `Remove filter: ${label}`);
        btn.appendChild(document.createTextNode(label));
        const x = document.createElement('span');
        x.setAttribute('aria-hidden', 'true');
        x.textContent = '×';
        btn.appendChild(x);
        btn.addEventListener('click', () => {
          activeFilters[group]?.delete(value);
          currentPage = 1;
          apply();
        });
        chipsEl.appendChild(btn);
      });
      chipsEl.hidden = chips.length === 0;
    }

    /* ── URL state ──────────────────────────────────────────────── */
    function updateURL() {
      const p = new URLSearchParams();
      Object.entries(URL_PARAMS).forEach(([group, param]) => {
        const active = activeFilters[group];
        if (active.size > 0) p.set(param, [...active].join(','));
      });
      if (activeSort !== 'latest') p.set('sort', activeSort);
      if (currentPage > 1)        p.set('page', String(currentPage));
      const qs = p.toString();
      history.replaceState(null, '', qs ? `?${qs}` : window.location.pathname);
    }

    /* ── Event bindings ─────────────────────────────────────────── */
    document.querySelectorAll<HTMLElement>('[data-filter-group]').forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.dataset.filterGroup ?? '';
        const value = btn.dataset.filterValue ?? '';
        const active = activeFilters[group];
        if (!active) return;
        active.has(value) ? active.delete(value) : active.add(value);
        currentPage = 1;
        apply();
      });
    });

    [allArticlesBtn, mobileAllBtn].forEach(btn => {
      btn?.addEventListener('click', () => {
        Object.values(activeFilters).forEach(s => s.clear());
        currentPage = 1;
        apply();
      });
    });

    sortEl?.addEventListener('change', () => {
      activeSort = sortEl.value;
      currentPage = 1;
      apply();
    });

    /* ── Initial render ─────────────────────────────────────────── */
    apply();
  })();
</script>

<script>
  /* ── View toggle: List ↔ Map ─────────────────────────────────────────────
     Toggles #kb-list-body (single container) vs #kb-canvas-wrapper.
     Persists in sessionStorage. Canvas initialises lazily on first activation.
  ──────────────────────────────────────────────────────────────────────── */
  (function () {
    const SESSION_KEY = 'kb-view';

    const kbPageEl   = document.getElementById('kb-page')           as HTMLElement | null;
    const listBtn    = document.getElementById('kb-view-list')      as HTMLButtonElement | null;
    const mapBtn     = document.getElementById('kb-view-map')       as HTMLButtonElement | null;
    const listBody   = document.getElementById('kb-list-body')      as HTMLElement | null;
    const canvasWrap = document.getElementById('kb-canvas-wrapper') as HTMLElement | null;

    function setToggleState(view: 'list' | 'map') {
      const isMap = view === 'map';
      listBtn?.setAttribute('aria-pressed', isMap ? 'false' : 'true');
      listBtn?.classList.toggle('kb-view-toggle__btn--active', !isMap);
      mapBtn?.setAttribute('aria-pressed', isMap ? 'true' : 'false');
      mapBtn?.classList.toggle('kb-view-toggle__btn--active', isMap);
    }

    function activateList() {
      document.documentElement.classList.remove('kb-canvas-init');
      kbPageEl?.classList.remove('kb-page--canvas');
      if (listBody)   listBody.hidden   = false;
      if (canvasWrap) canvasWrap.hidden = true;
      setToggleState('list');
      sessionStorage.setItem(SESSION_KEY, 'list');
    }

    function activateMap() {
      document.documentElement.classList.remove('kb-canvas-init');
      kbPageEl?.classList.add('kb-page--canvas');
      if (listBody)   listBody.hidden   = true;
      if (canvasWrap) {
        canvasWrap.hidden = false;
        // Fire once — KnowledgeCanvas.astro listens with { once: true }
        if (!canvasWrap.dataset.initialised) {
          canvasWrap.dispatchEvent(new CustomEvent('kb:canvas-activate'));
          canvasWrap.dataset.initialised = '1';
        }
      }
      setToggleState('map');
      sessionStorage.setItem(SESSION_KEY, 'map');
    }

    listBtn?.addEventListener('click', activateList);
    mapBtn?.addEventListener('click', activateMap);

    // Restore previous view on page load
    if (sessionStorage.getItem(SESSION_KEY) === 'map') activateMap();
  })();
</script>
