---
import GuideChapter from '../components/shared/GuideChapter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideHero from '../components/shared/GuideHero.astro';
import ConnectivityReading from '../components/connectivity/ConnectivityReading.astro';
import ConnectivityPlanner from '../components/connectivity/ConnectivityPlanner.astro';
import ConnectivityExplainer from '../components/connectivity/ConnectivityExplainer.astro';
---
<BaseLayout title="Connectivity — Design How Your Systems Connect" description="Understand public and private access, routing, DNS and redundant connections. Prepare a connectivity brief for a cloud workload.">
<GuideHero title="Design how your" accent="systems connect" description="A line on an architecture diagram hides several decisions. Who can reach the service, which path traffic takes, how its name resolves and what happens when that path fails." />
<GuideChapter id="workload" guide="connectivity" kind="calculator" title="Connectivity Planner" description="Five answers turn a line on the diagram into requirements, owners and tests." topics={["5 questions", "Live priorities", "Next steps"]} action="Start planning"><ConnectivityPlanner /></GuideChapter>
  <GuideChapter id="options" guide="connectivity" kind="learn" title="Four checks behind every connection" description="Follow the cargo through access, routes, name resolution and a surviving path." topics={["Access", "Routing", "DNS", "Continuity"]} action="Explore"><ConnectivityExplainer /></GuideChapter>
  <GuideChapter id="reading" guide="connectivity" kind="reading" title="Network design in practice" description="Selected articles and primary sources for the decisions that need a closer look." topics={["Practical articles", "Source documents"]} action="Browse notes"><ConnectivityReading /></GuideChapter>
</BaseLayout>
